      function skapaWorkspaceRad(
        namn: string,
        ikon: string,
        vald: boolean,
        valjFn: () => void,
        taBortFn: () => void
      ): HTMLElement {
        const rad = document.createElement("div");
        rad.className = "workspace-rad" + (vald ? " vald" : "");

        const knapp = document.createElement("button");
        knapp.type = "button";
        knapp.className = "workspace-rad-knapp";
        knapp.innerHTML = `<span class="ws-ikon">${ikon}</span><span class="ws-namn">${namn}</span>`;
        knapp.addEventListener("click", valjFn);

        const taBort = document.createElement("button");
        taBort.type = "button";
        taBort.className = "ikon-knapp fara workspace-ta-bort";
        taBort.textContent = "×";
        taBort.setAttribute("aria-label", "Ta bort " + namn);
        taBort.addEventListener("click", (e) => {
          e.stopPropagation();
          taBortFn();
        });

        rad.appendChild(knapp);
        rad.appendChild(taBort);
        return rad;
      }

      const elementIkoner: Record<ManuellElement["typ"], string> = {
        box: "▭", text: "T", bild: "🖼", knapp: "▢", scroll: "⇕", grid: "▦", input: "⌤",
      };

      function renderaWorkspace() {
        const container = document.getElementById("workspace-lista") as HTMLElement;
        container.innerHTML = "";
        const sida = hittaAktivSida();

        sida.element.forEach((el) => {
          container.appendChild(
            skapaWorkspaceRad(
              el.namn,
              elementIkoner[el.typ],
              valtElementId === el.id,
              () => {
                valtElementId = el.id;
                bytVerktyg("egenskaper");
                renderaWorkspace();
                const fonster = hittaLiveFonster();
                fonster?.wsValj?.(el.id);
              },
              () => {
                sida.element = sida.element.filter((x) => x.id !== el.id);
                if (valtElementId === el.id) valtElementId = null;
                renderaForhandsvisning();
                renderaWorkspace();
                renderaEgenskaper();
                markeraOsparat();
              }
            )
          );
        });

        if (!container.children.length) {
          const tom = document.createElement("p");
          tom.className = "panel-info";
          tom.textContent = "Inga element än. Lägg till via Element-verktyget eller be AI:n bygga en sida.";
          container.appendChild(tom);
        }
      }

      function startaDomanRedigering() {
        const nuvarande = document.getElementById("url-oval-text") as HTMLElement;
        if (!nuvarande) return;
        const input = document.createElement("input");
        input.type = "text";
        input.className = "url-oval-input";
        input.value = nuvarande.textContent || "";
        nuvarande.replaceWith(input);
        input.focus();
        input.select();

        const commit = () => {
          const span = document.createElement("span");
          span.className = "url-oval-text";
          span.id = "url-oval-text";
          span.textContent = input.value.trim() || "dittforetag.websiq.se";
          input.replaceWith(span);
        };
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") { e.preventDefault(); input.blur(); }
          if (e.key === "Escape") { e.preventDefault(); commit(); }
        });
        input.addEventListener("blur", commit);
      }

      urlOvalCog.addEventListener("click", startaDomanRedigering);

      function byggAstroExport(): string {
        const rader: string[] = [];
        rader.push("---");
        rader.push(`const sidTitel = ${JSON.stringify(hittaAktivSida().namn)};`);
        rader.push("---");
        rader.push("");
        rader.push("<html lang=\"sv\">");
        rader.push("  <head><meta charset=\"UTF-8\" /><title>{sidTitel}</title></head>");
        rader.push("  <body>");
        hittaAktivSida().element.forEach((el) => {
          rader.push("    " + renderaElementHtml(el));
        });
        rader.push("  </body>");
        rader.push("</html>");
        return rader.join("\n");
      }

      function exporteraAktivSida() {
        const kod = byggAstroExport();
        console.log(kod);
      }

      function tillamparPositionering(atgard: string) {
        const sida = hittaAktivSida();
        const el = sida.element.find((e) => e.id === valtElementId);
        if (!el) return;
        const doc = hittaLiveDokument();
        const bredd = doc?.documentElement?.clientWidth || 1200;
        const hojd = doc?.documentElement?.clientHeight || 800;

        if (atgard === "centrera-horisontellt") el.x = Math.max(0, Math.round((bredd - el.bredd) / 2));
        else if (atgard === "centrera-vertikalt") el.y = Math.max(0, Math.round((hojd - el.hojd) / 2));
        else if (atgard === "vanster") el.x = 0;
        else if (atgard === "hoger") el.x = Math.max(0, bredd - el.bredd);
        else if (atgard === "topp") el.y = 0;
        else if (atgard === "botten") el.y = Math.max(0, hojd - el.hojd);

        paivitaElementLive(el);
        uppdateraGeometriFalt();
        markeraOsparat();
      }

      function renderaPositioneringPanel() {
        const container = document.getElementById("positionera-innehall") as HTMLElement;
        container.innerHTML = "";
        const sida = hittaAktivSida();
        const el = sida.element.find((e) => e.id === valtElementId);
        if (!el) {
          const info = document.createElement("p");
          info.className = "panel-info";
          info.textContent = "Välj ett element i arbetsytan eller i Workspace för att kunna positionera det.";
          container.appendChild(info);
          return;
        }
        const alternativ: [string, string][] = [
          ["centrera-horisontellt", "Centrera horisontellt"],
          ["centrera-vertikalt", "Centrera vertikalt"],
          ["vanster", "Vänsterjustera"],
          ["hoger", "Högerjustera"],
          ["topp", "Toppjustera"],
          ["botten", "Bottenjustera"],
        ];
        alternativ.forEach(([varde, etikett]) => {
          const knapp = document.createElement("button");
          knapp.type = "button";
          knapp.className = "element-knapp";
          knapp.innerHTML = `<span class="ikon">⌖</span>${etikett}`;
          knapp.addEventListener("click", () => tillamparPositionering(varde));
          container.appendChild(knapp);
        });
      }

      function renderaInstallningarPanel() {
        const container = document.getElementById("installningar-innehall") as HTMLElement;
        container.innerHTML = "";

        const namnFalt = document.createElement("label");
        namnFalt.className = "insp-falt";
        namnFalt.innerHTML = `<span>Webbplatsnamn</span>`;
        const namnInput = document.createElement("input");
        namnInput.type = "text";
        namnInput.placeholder = "t.ex. Mitt Företag AB";
        namnFalt.appendChild(namnInput);
        container.appendChild(namnFalt);

        const beskrivningFalt = document.createElement("label");
        beskrivningFalt.className = "insp-falt";
        beskrivningFalt.innerHTML = `<span>SEO-beskrivning</span>`;
        const beskrivningInput = document.createElement("textarea");
        beskrivningInput.placeholder = "Kort beskrivning som visas i sökmotorer";
        beskrivningFalt.appendChild(beskrivningInput);
        container.appendChild(beskrivningFalt);

        skapaVal(
          container,
          "Plan",
          aktivPlan,
          [
            [Plan.None, "Ingen plan"],
            [Plan.Start, "Start (max 5 sidor)"],
            [Plan.Pro, "Pro (max 15 sidor)"],
            [Plan.Premium, "Premium (max 25 sidor)"],
          ],
          (v) => { aktivPlan = v as Plan; renderaSidor(); },
          () => {}
        );

        const exportBtn = document.createElement("button");
        exportBtn.type = "button";
        exportBtn.className = "element-knapp";
        exportBtn.innerHTML = `<span class="ikon">⇩</span>Exportera sidan (till konsolen)`;
        exportBtn.addEventListener("click", exporteraAktivSida);
        container.appendChild(exportBtn);
      }

      const tjanstKnappar = document.querySelectorAll<HTMLButtonElement>(".tjanst-knapp");
      const servicesDetalj = document.getElementById("services-detalj") as HTMLElement;
      tjanstKnappar.forEach((knapp) => {
        knapp.addEventListener("click", () => {
          tjanstKnappar.forEach((b) => b.classList.remove("aktiv"));
          knapp.classList.add("aktiv");
          const namn = knapp.dataset.tjanst || "";
          servicesDetalj.innerHTML = "";
          const info = document.createElement("p");
          info.className = "panel-info";
          info.textContent = `${namn} — kommer snart.`;
          servicesDetalj.appendChild(info);
        });
      });

      const DB_NAMN = "websiq-astro-db";
      const STORE_NAMN = "projekt";

      function oppnaDb(): Promise<IDBDatabase> {
        return new Promise((resolve, reject) => {
          const request = indexedDB.open(DB_NAMN, 2);
          request.onupgradeneeded = () => {
            const db = request.result;
            if (!db.objectStoreNames.contains(STORE_NAMN)) db.createObjectStore(STORE_NAMN);
          };
          request.onsuccess = () => resolve(request.result);
          request.onerror = () => reject(request.error);
        });
      }

      interface SparatProjekt {
        sidor: Sida[];
        aktivSidaId: string;
      }

      function uppdateraSparaKnappStatus() {
        if (harOsparadeAndringar) {
          sparaBtn.disabled = false;
          sparaStatus.textContent = "Spara";
        } else {
          sparaBtn.disabled = true;
          sparaStatus.textContent = "Sparat";
        }
      }

      function markeraOsparat() {
        harOsparadeAndringar = true;
        uppdateraSparaKnappStatus();
      }

      async function sparaOchVisa(automatiskt: boolean) {
        if (!harOsparadeAndringar) return;
        sparaBtn.classList.add("sparar");
        sparaBtn.disabled = true;
        sparaStatus.textContent = "Sparar…";
        try {
          await sparaProjekt();
          harOsparadeAndringar = false;
          sparaStatus.textContent = "Sparat ✓";
        } catch {
          harOsparadeAndringar = true;
          sparaStatus.textContent = "Kunde inte spara";
        }
        sparaBtn.classList.remove("sparar");
        window.setTimeout(() => {
          uppdateraSparaKnappStatus();
        }, 1600);
      }

      function sparaProjekt(): Promise<void> {
        return oppnaDb().then(
          (db) =>
            new Promise<void>((resolve, reject) => {
              const tx = db.transaction(STORE_NAMN, "readwrite");
              tx.objectStore(STORE_NAMN).put({ sidor, aktivSidaId }, "projekt");
              tx.oncomplete = () => resolve();
              tx.onerror = () => reject(tx.error);
            })
        );
      }

      function laddaProjekt(): Promise<SparatProjekt | null> {
        return oppnaDb().then(
          (db) =>
            new Promise<SparatProjekt | null>((resolve, reject) => {
              const tx = db.transaction(STORE_NAMN, "readonly");
              const req = tx.objectStore(STORE_NAMN).get("projekt");
              req.onsuccess = () => resolve((req.result as SparatProjekt) ?? null);
              req.onerror = () => reject(req.error);
            })
        );
      }

      sparaBtn.addEventListener("click", () => sparaOchVisa(false));
      window.setInterval(() => sparaOchVisa(true), 60 * 1000);

      async function initiera() {
        let sparat: SparatProjekt | null = null;
        try {
          sparat = await laddaProjekt();
        } catch {
          sparat = null;
        }

        if (sparat && sparat.sidor && sparat.sidor.length) {
          sidor = sparat.sidor;
          sidor.forEach((s) => {
            if (!s.element) s.element = [];
          });
          const indexSida = sidor.find((s) => s.namn === "index.astro");
          if (indexSida) indexSida.laast = true;
          aktivSidaId = sparat.aktivSidaId;
        }

        renderaSidor();
        renderaForhandsvisning();
        visaTomChattMeddelande();
        uppdateraTokenVisning();
        uppdateraSparaKnappStatus();
      }

      initiera();
    </script>
  </body>
</html>

