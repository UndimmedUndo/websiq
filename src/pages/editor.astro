    color: #9aa2b6;
  }
  .tom-sida-badge {
    font-family: 'JetBrains Mono', monospace; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase;
    color: #7c93ff; border: 1px solid rgba(124, 147, 255, .35); border-radius: 999px; padding: 5px 14px;
  }
  .tom-sida-ikon {
    width: 56px; height: 56px; border-radius: 18px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #ffb238, #ff8a3d); color: #10141c; font-size: 24px; font-weight: 700;
    box-shadow: 0 16px 32px -14px rgba(255, 178, 56, 0.55);
  }
  .tom-sida h2 { font-family: 'Sora', sans-serif; font-size: 1.35rem; color: #eef0f6; margin: 0; }
  .tom-sida p { font-size: 0.92rem; max-width: 380px; line-height: 1.6; margin: 0; color: #9aa2b6; }
</style>
<style id="ws-hover-stilar">${hoverStilar}</style>
</head>
<body><div class="ws-yta">${innehall}</div>
<script>
(function(){
  var valtId = ${valtIdJson};
  var dragging = null;
  var resizing = null;

  function elementNode(id) { return document.querySelector('[data-el-id="' + id + '"]'); }

  function elementRotation(node) {
    var m = node.style.transform.match(/rotate\\(([-\\d.]+)deg\\)/);
    return m ? parseFloat(m[1]) : 0;
  }

  function skalaTextTillBox(node) {
    if (!node || node.getAttribute('data-skalad-text') !== '1') return;
    var h = node.clientHeight;
    var w = node.clientWidth;
    if (!h || !w) return;
    var storlek = Math.max(6, Math.floor(h * 0.72));
    node.style.fontSize = storlek + 'px';
    node.style.lineHeight = h + 'px';
    while (node.scrollWidth > w && storlek > 6) {
      storlek -= 1;
      node.style.fontSize = storlek + 'px';
    }
  }

  function skalaAllaTexter() {
    document.querySelectorAll('[data-skalad-text="1"]').forEach(function (node) {
      skalaTextTillBox(node);
    });
  }

  function taBortMarkering() {
    var m = document.getElementById('ws-markering');
    if (m) m.remove();
  }

  function justeraMarkering(id) {
    var m = document.getElementById('ws-markering');
    var node = elementNode(id);
    if (!m || !node) return;
    var left = parseFloat(node.style.left);
    var top = parseFloat(node.style.top);
    var w = parseFloat(node.style.width);
    var h = parseFloat(node.style.height);
    var rot = elementRotation(node);
    m.style.left = (left - 3) + 'px';
    m.style.top = (top - 3) + 'px';
    m.style.width = (w + 6) + 'px';
    m.style.height = (h + 6) + 'px';
    m.style.transformOrigin = 'center center';
    m.style.transform = 'rotate(' + rot + 'deg)';
  }

  function skapaMarkering(id) {
    taBortMarkering();
    var node = elementNode(id);
    if (!node) return;
    var m = document.createElement('div');
    m.id = 'ws-markering';
    m.setAttribute('data-target', id);
    m.style.cssText = 'position:absolute;pointer-events:none;border:2px solid #4c6fff;border-radius:6px;z-index:9999;box-shadow:0 0 0 3px rgba(76,111,255,0.12);';
    ['tl', 'tr', 'bl', 'br'].forEach(function (pos) {
      var h = document.createElement('span');
      h.setAttribute('data-handle', pos);
      h.style.cssText = 'position:absolute;width:13px;height:13px;border-radius:50%;background:#ffffff;border:2px solid #4c6fff;pointer-events:auto;box-shadow:0 2px 6px rgba(15,20,32,0.25);' +
        (pos.indexOf('t') === 0 ? 'top:-7px;' : 'bottom:-7px;') +
        (pos.indexOf('l') !== -1 ? 'left:-7px;cursor:nwse-resize;' : 'right:-7px;cursor:nesw-resize;');
      m.appendChild(h);
    });
    document.body.appendChild(m);
    justeraMarkering(id);
  }

  function valj(id) {
    valtId = id;
    skapaMarkering(id);
    window.parent.postMessage({ type: 'select', id: id }, '*');
  }

  function avmarkera() {
    valtId = null;
    taBortMarkering();
    window.parent.postMessage({ type: 'deselect' }, '*');
  }

  window.wsValj = valj;
  window.wsAvmarkera = avmarkera;

  document.addEventListener('mousedown', function (e) {
    var lankEl = e.target.closest ? e.target.closest('[data-lank-sida]') : null;
    var handleEl = e.target.closest ? e.target.closest('[data-handle]') : null;
    if (handleEl && valtId) {
      var hNode = elementNode(valtId);
      if (!hNode) return;
      e.preventDefault();
      var hLeft = parseFloat(hNode.style.left), hTop = parseFloat(hNode.style.top);
      var hW = parseFloat(hNode.style.width), hH = parseFloat(hNode.style.height);
      resizing = {
        handle: handleEl.getAttribute('data-handle'), startX: e.clientX, startY: e.clientY,
        startLeft: hLeft, startTop: hTop,
        startW: hW, startH: hH,
        rot: elementRotation(hNode)
      };
      return;
    }
    var elNode = e.target.closest ? e.target.closest('[data-el-id]') : null;
    if (elNode) {
      var id = elNode.getAttribute('data-el-id');
      var maInmatning = e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA';
      if (maInmatning && valtId === id) {
        return;
      }
      e.preventDefault();
      if (valtId !== id) valj(id);
      dragging = {
        id: id, startX: e.clientX, startY: e.clientY,
        startLeft: parseFloat(elNode.style.left), startTop: parseFloat(elNode.style.top),
        moved: false, lankSida: lankEl ? lankEl.getAttribute('data-lank-sida') : null
      };
      return;
    }
    if (valtId) avmarkera();
  });

  document.addEventListener('mousemove', function (e) {
    if (dragging) {
      var dx = e.clientX - dragging.startX, dy = e.clientY - dragging.startY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragging.moved = true;
      var nx = Math.max(0, Math.round(dragging.startLeft + dx));
      var ny = Math.max(0, Math.round(dragging.startTop + dy));
      var node = elementNode(dragging.id);
      if (node) { node.style.left = nx + 'px'; node.style.top = ny + 'px'; }
      justeraMarkering(dragging.id);
      window.parent.postMessage({ type: 'move', id: dragging.id, x: nx, y: ny }, '*');
    } else if (resizing) {
      var rad = resizing.rot * Math.PI / 180;
      var cosR = Math.cos(rad), sinR = Math.sin(rad);
      var screenDx = e.clientX - resizing.startX, screenDy = e.clientY - resizing.startY;
      var localDx = screenDx * cosR + screenDy * sinR;
      var localDy = -screenDx * sinR + screenDy * cosR;

      var w = resizing.startW, h = resizing.startH;
      var signX = resizing.handle.indexOf('l') !== -1 ? -1 : 1;
      var signY = resizing.handle.indexOf('t') === 0 ? -1 : 1;
      var newW = Math.max(20, Math.round(w + signX * localDx));
      var newH = Math.max(20, Math.round(h + signY * localDy));

      var cx = resizing.startLeft + w / 2;
      var cy = resizing.startTop + h / 2;
      var deltaW = newW - w, deltaH = newH - h;
      var localCenterDx = (signX * deltaW) / 2;
      var localCenterDy = (signY * deltaH) / 2;
      var screenCenterDx = localCenterDx * cosR - localCenterDy * sinR;
      var screenCenterDy = localCenterDx * sinR + localCenterDy * cosR;
      var newCx = cx + screenCenterDx;
      var newCy = cy + screenCenterDy;
      var left = Math.round(newCx - newW / 2);
      var top = Math.round(newCy - newH / 2);

      var rNode = elementNode(valtId);
      if (rNode) {
        rNode.style.left = left + 'px'; rNode.style.top = top + 'px';
        rNode.style.width = newW + 'px'; rNode.style.height = newH + 'px';
        skalaTextTillBox(rNode);
      }
      justeraMarkering(valtId);
      window.parent.postMessage({ type: 'resize', id: valtId, x: left, y: top, bredd: newW, hojd: newH }, '*');
    }
  });

  document.addEventListener('mouseup', function () {
    if (dragging) {
      var node = elementNode(dragging.id);
      if (node) window.parent.postMessage({ type: 'moveend', id: dragging.id, x: parseFloat(node.style.left), y: parseFloat(node.style.top) }, '*');
      if (!dragging.moved && dragging.lankSida) {
        window.parent.postMessage({ type: 'navigate', sida: dragging.lankSida }, '*');
      }
      dragging = null;
    }
    if (resizing) {
      var rNode = elementNode(valtId);
      if (rNode) window.parent.postMessage({ type: 'resizeend', id: valtId, x: parseFloat(rNode.style.left), y: parseFloat(rNode.style.top), bredd: parseFloat(rNode.style.width), hojd: parseFloat(rNode.style.height) }, '*');
      resizing = null;
    }
  });

  document.addEventListener('touchstart', function (e) {
    var t = e.touches[0];
    var handleEl = t.target.closest ? t.target.closest('[data-handle]') : null;
    var elNode = t.target.closest ? t.target.closest('[data-el-id]') : null;
    var lankEl = t.target.closest ? t.target.closest('[data-lank-sida]') : null;
    if (handleEl && valtId) {
      var hNode = elementNode(valtId);
      if (!hNode) return;
      var hLeft = parseFloat(hNode.style.left), hTop = parseFloat(hNode.style.top);
      var hW = parseFloat(hNode.style.width), hH = parseFloat(hNode.style.height);
      resizing = { handle: handleEl.getAttribute('data-handle'), startX: t.clientX, startY: t.clientY, startLeft: hLeft, startTop: hTop, startW: hW, startH: hH, rot: elementRotation(hNode) };
      e.preventDefault();
    } else if (elNode) {
      var id = elNode.getAttribute('data-el-id');
      if (valtId !== id) valj(id);
      dragging = { id: id, startX: t.clientX, startY: t.clientY, startLeft: parseFloat(elNode.style.left), startTop: parseFloat(elNode.style.top), moved: false, lankSida: lankEl ? lankEl.getAttribute('data-lank-sida') : null };
      e.preventDefault();
    }
  }, { passive: false });

  document.addEventListener('touchmove', function (e) {
    if (!dragging && !resizing) return;
    e.preventDefault();
    var t = e.touches[0];
    var fake = { clientX: t.clientX, clientY: t.clientY };
    var evt = new MouseEvent('mousemove', { clientX: fake.clientX, clientY: fake.clientY });
    document.dispatchEvent(evt);
  }, { passive: false });

  document.addEventListener('touchend', function () {
    document.dispatchEvent(new MouseEvent('mouseup'));
  });

  document.addEventListener('keydown', function (e) {
    if (!valtId) return;
    var aktivtElement = document.activeElement;
    if (aktivtElement && (aktivtElement.tagName === 'INPUT' || aktivtElement.tagName === 'TEXTAREA')) return;
    if (e.key === 'Delete' || e.key === 'Backspace') {
      e.preventDefault();
      window.parent.postMessage({ type: 'delete', id: valtId }, '*');
      avmarkera();
    } else if (e.key.indexOf('Arrow') === 0) {
      e.preventDefault();
      var node = elementNode(valtId);
      if (!node) return;
      var steg = e.shiftKey ? 10 : 1;
      var left = parseFloat(node.style.left), top = parseFloat(node.style.top);
      if (e.key === 'ArrowLeft') left -= steg;
      if (e.key === 'ArrowRight') left += steg;
      if (e.key === 'ArrowUp') top -= steg;
      if (e.key === 'ArrowDown') top += steg;
      left = Math.max(0, left); top = Math.max(0, top);
      node.style.left = left + 'px'; node.style.top = top + 'px';
      justeraMarkering(valtId);
      window.parent.postMessage({ type: 'moveend', id: valtId, x: left, y: top }, '*');
    }
  });

  if (valtId && elementNode(valtId)) skapaMarkering(valtId);
  skalaAllaTexter();
  window.addEventListener('resize', skalaAllaTexter);
})();
<\/script>
</body>
</html>`;
      }

      interface Sida {
        id: string;
        namn: string;
        element: ManuellElement[];
        laast?: boolean;
      }

      let sidor: Sida[] = [{ id: skapaId(), namn: "index.astro", element: [], laast: true }];
      let aktivSidaId = sidor[0].id;
      let aktivtVerktyg: "ai" | "element" | "egenskaper" | "sidor" | "workspace" | "services" | "positionera" | "molnbackuper" | "installningar" = "ai";
      let valtElementId: string | null = null;
      let harOsparadeAndringar = false;
      const AI_TOKENS_TOTALT = 800000;

      function hittaAktivSida(): Sida {
        return sidor.find((s) => s.id === aktivSidaId) || sidor[0];
      }

      const promptFalt = document.getElementById("ai-prompt") as HTMLTextAreaElement;
      const skickaBtn = document.getElementById("ai-send") as HTMLButtonElement;
      const meddelandeLista = document.getElementById("chat-messages") as HTMLElement;
      const previewIframe = document.getElementById("preview-frame") as HTMLIFrameElement;
      const sidorLaggTillBtn = document.getElementById("sidor-lagg-till-knapp") as HTMLButtonElement;
      const sparaBtn = document.getElementById("spara-knapp") as HTMLButtonElement;
      const sparaStatus = document.getElementById("spara-status-text") as HTMLElement;
      const verktygTitel = document.getElementById("verktyg-titel") as HTMLElement;
      const urlOvalCog = document.getElementById("url-oval-cog") as HTMLButtonElement;
      const chatRensaBtn = document.getElementById("chat-rensa-knapp") as HTMLButtonElement;

      function scrollaNer() {
        meddelandeLista.scrollTop = meddelandeLista.scrollHeight;
      }

      function skapaBubbla(text: string, roll: "user" | "ai"): HTMLElement {
        const bubbla = document.createElement("div");
        bubbla.className = `bubbla bubbla-${roll}`;
        const rad = document.createElement("p");
        rad.className = "bubbla-text";
        rad.textContent = text;
        bubbla.appendChild(rad);
        return bubbla;
      }

      function renderaForhandsvisning() {
        const sida = hittaAktivSida();
        previewIframe.srcdoc = byggForhandsvisningsDokument(sida.element, valtElementId);
      }

      function hittaLiveDokument(): Document | null {
        try {
          return previewIframe.contentDocument || previewIframe.contentWindow?.document || null;
        } catch {
          return null;
        }
      }

      function hittaLiveFonster(): (Window & { wsValj?: (id: string) => void; wsAvmarkera?: () => void }) | null {
        try {
          return (previewIframe.contentWindow as any) || null;
        } catch {
          return null;
        }
      }

      let liveElementCache: { id: string; node: HTMLElement } | null = null;

      function uppdateraHoverStilarLive() {
        const doc = hittaLiveDokument();
        const stilTag = doc?.getElementById("ws-hover-stilar");
        if (!stilTag) return;
        const sida = hittaAktivSida();
        stilTag.textContent = byggHoverStilar(sida.element);
      }

      function paivitaElementLive(el: ManuellElement) {
        let node = liveElementCache?.id === el.id ? liveElementCache.node : null;
        if (!node || !node.isConnected) {
          const doc = hittaLiveDokument();
          node = (doc?.querySelector(`[data-el-id="${el.id}"]`) as HTMLElement) || null;
          if (node) liveElementCache = { id: el.id, node };
        }
        if (!node) { renderaForhandsvisning(); return; }

        const rotation = el.rotation ?? 0;
        const radie = el.radie ?? 0;
        const opacitet = (el.opacitet ?? 100) / 100;
        const zIndex = el.zIndex ?? 1;
        const skuggaCss = el.skugga
          ? `${el.skuggaX ?? 0}px ${el.skuggaY ?? 14}px ${el.skuggaBlur ?? 24}px ${el.skuggaSpridning ?? -6}px ${el.skuggaFarg || "rgba(0,0,0,0.55)"}`
          : "none";
        const kantstil = el.kantstil || "solid";
        const bakgrundVarde = (farg: string | undefined, fallback: string) =>
          el.gradient ? `linear-gradient(${el.gradientVinkel ?? 135}deg, ${farg || fallback}, ${el.gradientFarg2 || "#7c93ff"})` : (farg || fallback);

        node.style.left = `${el.x}px`;
        node.style.top = `${el.y}px`;
        node.style.width = `${el.bredd}px`;
        node.style.height = `${el.hojd}px`;
        node.style.transform = `rotate(${rotation}deg)`;
        node.style.borderRadius = `${radie}px`;
        node.style.opacity = String(opacitet);
        node.style.zIndex = String(zIndex);
        node.style.mixBlendMode = el.blandningslage || "normal";
        node.style.overflow = el.typ === "scroll" ? "auto" : (el.overflowDold ? "hidden" : "visible");
        node.style.cursor = el.cursor || "default";
        node.style.boxShadow = skuggaCss;
        (node.style as any).backdropFilter = el.glasEffekt ? `blur(${el.glasStyrka ?? 10}px)` : "none";
        (node.style as any).webkitBackdropFilter = el.glasEffekt ? `blur(${el.glasStyrka ?? 10}px)` : "none";
        if (el.lank) node.setAttribute("data-lank-sida", el.lank);
        else node.removeAttribute("data-lank-sida");

        if (el.typ === "text") {
          node.textContent = el.text || "";
          node.style.color = el.textFarg || "#10141c";
          node.style.fontWeight = el.fontVikt || "400";
          node.style.textAlign = el.textAlign || "center";
          node.style.justifyContent = el.textAlign === "left" ? "flex-start" : el.textAlign === "right" ? "flex-end" : "center";
          node.style.background = el.bakgrund && el.bakgrund !== "transparent" ? el.bakgrund : "transparent";
          node.style.letterSpacing = `${el.bokstavsMellanrum ?? 0}px`;
          node.style.textDecoration = el.understruken ? "underline" : "none";
          node.style.textShadow = el.textskugga ? "0 3px 10px rgba(0,0,0,0.4)" : "none";
          if (el.skaladText) {
            node.setAttribute("data-skalad-text", "1");
            const fonster = hittaLiveFonster();
            (fonster as any)?.skalaTextTillBox?.(node);
            node.style.lineHeight = node.style.lineHeight || `${el.hojd}px`;
          } else {
            node.removeAttribute("data-skalad-text");
            node.style.fontSize = `${el.fontStorlek ?? 16}px`;
            node.style.lineHeight = String(el.radavstand ?? 1.3);
          }
        } else if (el.typ === "knapp") {
          node.textContent = el.text || "Knapp";
          node.style.background = bakgrundVarde(el.bakgrund, "#ffb238");
          node.style.color = el.textFarg || "#10141c";
          node.style.fontSize = `${el.fontStorlek ?? 16}px`;
          node.style.fontWeight = el.fontVikt || "600";
          node.style.letterSpacing = `${el.bokstavsMellanrum ?? 0}px`;
          node.style.textDecoration = el.understruken ? "underline" : "none";
        } else if (el.typ === "bild") {
          const img = node.querySelector("img") as HTMLImageElement | null;
          if (img) {
            img.src = el.bildUrl || "https://placehold.co/400x300/f3f1ea/9aa2b6?text=Bild";
            img.style.objectFit = el.bildFit || "cover";
          }
          node.style.border = `${el.kantbredd ?? 0}px ${kantstil} ${el.kantfarg || "transparent"}`;
        } else if (el.typ === "scroll") {
          const inreDiv = node.firstElementChild as HTMLElement | null;
          if (inreDiv) inreDiv.innerHTML = renderaScrollInnehall(el);
          node.style.background = el.bakgrund || "#f3f1ea";
          node.style.border = `${el.kantbredd ?? 1}px ${kantstil} ${el.kantfarg || "#e4e0d4"}`;
        } else if (el.typ === "grid") {
          node.style.display = "grid";
          node.style.gridTemplateColumns = `repeat(${Math.max(1, el.gridKolumner ?? 3)}, 1fr)`;
          node.style.gridTemplateRows = `repeat(${Math.max(1, el.gridRader ?? 2)}, 1fr)`;
          (node.style as any).gridAutoRows = el.gridCellHojd ? `${el.gridCellHojd}px` : "";
          node.style.gap = `${el.gridMellanrum ?? 12}px`;
          node.style.background = bakgrundVarde(el.bakgrund, "transparent");
          node.innerHTML = renderaGridCeller(el);
        } else if (el.typ === "input") {
          const input = node.querySelector("input") as HTMLInputElement | null;
          if (input) {
            input.placeholder = el.platshallareText || "Skriv något …";
            input.style.background = el.bakgrund || "#ffffff";
            input.style.color = el.textFarg || "#10141c";
            input.style.fontSize = `${el.fontStorlek ?? 15}px`;
            input.style.border = `${el.kantbredd ?? 1}px ${kantstil} ${el.kantfarg || "#d8d4c8"}`;
            input.style.borderRadius = `${radie}px`;
          }
        } else {
          node.style.background = bakgrundVarde(el.bakgrund, "#f3f1ea");
          node.style.border = `${el.kantbredd ?? 0}px ${kantstil} ${el.kantfarg || "transparent"}`;
        }

        uppdateraHoverStilarLive();
        reposMarkeringOmVald(el);
      }

      function reposMarkeringOmVald(el: ManuellElement) {
        if (valtElementId !== el.id) return;
        const doc = hittaLiveDokument();
        const markering = doc?.getElementById("ws-markering") as HTMLElement | null;
        if (!markering) return;
        markering.style.left = `${el.x - 3}px`;
        markering.style.top = `${el.y - 3}px`;
        markering.style.width = `${el.bredd + 6}px`;
        markering.style.height = `${el.hojd + 6}px`;
        markering.style.transformOrigin = "center center";
        markering.style.transform = `rotate(${el.rotation ?? 0}deg)`;
      }

      function uppdateraGeometriFalt() {
        if (aktivtVerktyg !== "egenskaper") return;
        const sida = hittaAktivSida();
        const el = sida.element.find((e) => e.id === valtElementId);
        if (!el) return;
        const satt = (id: string, varde: number) => {
          const falt = document.getElementById(id) as HTMLInputElement | null;
          if (falt && document.activeElement !== falt) falt.value = String(varde);
        };
        satt("egenskap-x", el.x);
        satt("egenskap-y", el.y);
        satt("egenskap-bredd", el.bredd);
        satt("egenskap-hojd", el.hojd);
      }

      function hanteraIframeMeddelande(e: MessageEvent) {
        if (e.source !== previewIframe.contentWindow) return;
        const data = e.data;
        if (!data || typeof data !== "object" || !("type" in data)) return;
        const sida = hittaAktivSida();

        if (data.type === "select") {
          if (valtElementId !== data.id) {
            valtElementId = data.id;
            bytVerktyg("egenskaper");
            renderaWorkspace();
          }
        } else if (data.type === "deselect") {
          if (valtElementId !== null) {
            valtElementId = null;
            if (aktivtVerktyg === "egenskaper") renderaEgenskaper();
            renderaWorkspace();
          }
        } else if (data.type === "navigate") {
          const malSida = hittaSidaViaNamn(String(data.sida || ""));
          if (malSida) bytAktivSida(malSida.id);
        } else if (data.type === "move" || data.type === "resize") {
          const el = sida.element.find((x) => x.id === data.id);
          if (!el) return;
          el.x = data.x;
          el.y = data.y;
          if (typeof data.bredd === "number") el.bredd = data.bredd;
          if (typeof data.hojd === "number") el.hojd = data.hojd;
          uppdateraGeometriFalt();
        } else if (data.type === "moveend" || data.type === "resizeend") {
          const el = sida.element.find((x) => x.id === data.id);
          if (!el) return;
          el.x = data.x;
          el.y = data.y;
          if (typeof data.bredd === "number") el.bredd = data.bredd;
          if (typeof data.hojd === "number") el.hojd = data.hojd;
          uppdateraGeometriFalt();
          markeraOsparat();
        } else if (data.type === "delete") {
          const idx = sida.element.findIndex((x) => x.id === data.id);
          if (idx === -1) return;
          sida.element.splice(idx, 1);
          if (valtElementId === data.id) valtElementId = null;
          renderaForhandsvisning();
          if (aktivtVerktyg === "egenskaper") renderaEgenskaper();
          renderaWorkspace();
          markeraOsparat();
        }
      }

      window.addEventListener("message", hanteraIframeMeddelande);

      function bytAktivSida(id: string) {
        aktivSidaId = id;
        valtElementId = null;
        renderaSidor();
        renderaForhandsvisning();
        if (aktivtVerktyg === "egenskaper") renderaEgenskaper();
        if (aktivtVerktyg === "workspace") renderaWorkspace();
      }

      function raderaSida(id: string) {
        const sida = sidor.find((s) => s.id === id);
        if (!sida || sidor.length <= 1 || sida.laast) return;
        if (!window.confirm(`Ta bort "${sida.namn}"? Detta går inte att ångra.`)) return;

        const index = sidor.findIndex((s) => s.id === id);
        sidor = sidor.filter((s) => s.id !== id);
        if (aktivSidaId === id) {
          aktivSidaId = sidor[Math.max(0, index - 1)].id;
          valtElementId = null;
        }
        renderaSidor();
        renderaForhandsvisning();
        if (aktivtVerktyg === "egenskaper") renderaEgenskaper();
        if (aktivtVerktyg === "workspace") renderaWorkspace();
        markeraOsparat();
      }

      function startaOmdopning(wrap: HTMLElement, sida: Sida) {
        if (sida.laast) return;
        const bas = sida.namn.replace(/\.astro$/, "");
        wrap.innerHTML = "";
        wrap.classList.add("redigerar");

        const input = document.createElement("input");
        input.type = "text";
        input.className = "sida-input";
        input.value = bas;

        const suffix = document.createElement("span");
        suffix.className = "sida-suffix";
        suffix.textContent = ".astro";

        const commit = () => {
          const nyBas = input.value.trim().replace(/\.astro$/, "");
          if (nyBas && normaliseraSidnamn(nyBas) !== "index") sida.namn = nyBas + ".astro";
          renderaSidor();
          markeraOsparat();
        };
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") { e.preventDefault(); input.blur(); }
          if (e.key === "Escape") { e.preventDefault(); renderaSidor(); }
        });
        input.addEventListener("blur", commit);

        wrap.appendChild(input);
        wrap.appendChild(suffix);
        input.focus();
        input.select();
      }

      function renderaSidor() {
        const container = document.getElementById("sidor-lista-vertikal") as HTMLElement | null;
        if (!container) return;
        container.innerHTML = "";
        sidor.forEach((sida) => {
          const rad = document.createElement("div");
          rad.className = "sida-rad" + (sida.id === aktivSidaId ? " aktiv" : "");

          const namnKnapp = document.createElement("button");
          namnKnapp.type = "button";
          namnKnapp.className = "sida-rad-namn";
          namnKnapp.textContent = sida.namn;
          namnKnapp.addEventListener("click", () => bytAktivSida(sida.id));
          rad.appendChild(namnKnapp);

          const atgarder = document.createElement("div");
          atgarder.className = "sida-rad-atgarder";

          if (sida.laast) {
            const laasIkon = document.createElement("span");
            laasIkon.className = "ikon-knapp sida-laast-ikon";
            laasIkon.textContent = "🔒";
            laasIkon.title = "Denna sida kan inte döpas om eller tas bort";
            atgarder.appendChild(laasIkon);
          } else {
            const pennaKnapp = document.createElement("button");
            pennaKnapp.type = "button";
            pennaKnapp.className = "ikon-knapp";
            pennaKnapp.innerHTML = "✎";
            pennaKnapp.setAttribute("aria-label", "Byt namn på " + sida.namn);
            pennaKnapp.addEventListener("click", (e) => {
              e.stopPropagation();
              startaOmdopning(rad, sida);
            });
            atgarder.appendChild(pennaKnapp);

            if (sidor.length > 1) {
              const soptunnaKnapp = document.createElement("button");
              soptunnaKnapp.type = "button";
              soptunnaKnapp.className = "ikon-knapp fara";
              soptunnaKnapp.innerHTML = "🗑";
              soptunnaKnapp.setAttribute("aria-label", "Ta bort " + sida.namn);
              soptunnaKnapp.addEventListener("click", (e) => {
                e.stopPropagation();
                raderaSida(sida.id);
              });
              atgarder.appendChild(soptunnaKnapp);
            }
          }

          rad.appendChild(atgarder);
          container.appendChild(rad);
        });

        const laggTillBtn = document.getElementById("sidor-lagg-till-knapp") as HTMLButtonElement | null;
        if (laggTillBtn) laggTillBtn.disabled = sidor.length >= maxTillatnaSidor();
      }

      sidorLaggTillBtn.addEventListener("click", () => {
        if (sidor.length >= maxTillatnaSidor()) {
          window.alert(`Din plan tillåter max ${maxTillatnaSidor()} sidor. Uppgradera för att lägga till fler.`);
          return;
        }
        const nySida: Sida = { id: skapaId(), namn: `sida-${sidor.length + 1}.astro`, element: [] };
        sidor.push(nySida);
        aktivSidaId = nySida.id;
        valtElementId = null;
        renderaSidor();
        renderaForhandsvisning();
        window.requestAnimationFrame(() => {
          const scroll = document.getElementById("sidor-lista-vertikal") as HTMLElement;
          scroll.scrollTo({ top: scroll.scrollHeight, behavior: "smooth" });
        });
        markeraOsparat();
      });

      function uppdateraTokenVisning() {
        const falt = document.getElementById("ai-token-status") as HTMLElement | null;
        if (!falt) return;
        falt.textContent = `AI tokens: ${AI_TOKENS_TOTALT.toLocaleString("sv-SE")}`;
        falt.classList.remove("tokens-slut");
      }

      function skickaPrompt() {
        const text = promptFalt.value.trim();
        if (!text) return;

        meddelandeLista.appendChild(skapaBubbla(text, "user"));
        promptFalt.value = "";
        scrollaNer();

        const tankBubbla = skapaBubbla("Bygger sidan …", "ai");
        tankBubbla.classList.add("bubbla-tankande");
        meddelandeLista.appendChild(tankBubbla);
        scrollaNer();
        skickaBtn.disabled = true;

        window.setTimeout(() => {
          tankBubbla.remove();
          const mall = valjMall(text);
          const sida = hittaAktivSida();
          const nyaElement = mall.skapaElement();
          sida.element.push(...nyaElement);
          renderaForhandsvisning();
          const svar = `Klart! Jag har lagt till en ${mall.titel} som element på ${sida.namn} — du hittar och redigerar dem under Workspace.`;
          meddelandeLista.appendChild(skapaBubbla(svar, "ai"));
          scrollaNer();
          skickaBtn.disabled = false;
          if (aktivtVerktyg === "workspace") renderaWorkspace();
          markeraOsparat();
        }, 700);
      }

      skickaBtn.addEventListener("click", skickaPrompt);
      promptFalt.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          skickaPrompt();
        }
      });

      function rensaKonversation() {
        if (!meddelandeLista.children.length) return;
        if (!window.confirm("Rensa hela konversationen? Detta går inte att ångra.")) return;
        meddelandeLista.innerHTML = "";
        visaTomChattMeddelande();
      }

      function visaTomChattMeddelande() {
        meddelandeLista.appendChild(
          skapaBubbla(
            "Hej! Beskriv sidan du vill se, t.ex. \"gör en prissektion\" eller \"kontaktformulär\". Tryck Skicka för att generera elementen till höger. Du kan sedan dra elementen direkt i arbetsytan och ändra storlek genom att dra i hörnen.",
            "ai"
          )
        );
        scrollaNer();
      }

      chatRensaBtn.addEventListener("click", rensaKonversation);

      const verktygTitlar: Record<string, string> = {
        ai: "Websiq AI byggare",
        element: "Element",
        egenskaper: "Egenskaper",
        sidor: "Sidor",
        workspace: "Workspace",
        services: "Services",
        positionera: "Positionera",
        molnbackuper: "Molnbackuper",
        installningar: "Inställningar",
      };

      function bytVerktyg(v: "ai" | "element" | "egenskaper" | "sidor" | "workspace" | "services" | "positionera" | "molnbackuper" | "installningar") {
        aktivtVerktyg = v;
        document.querySelectorAll(".verktygsknapp").forEach((b) => {
          (b as HTMLElement).classList.toggle("aktiv", (b as HTMLElement).dataset.verktyg === v);
        });
        document.querySelectorAll(".panel-vy").forEach((p) => {
          p.classList.toggle("aktiv", p.id === `panel-${v}`);
        });
        verktygTitel.textContent = verktygTitlar[v];
        if (v === "egenskaper") renderaEgenskaper();
        if (v === "sidor") renderaSidor();
        if (v === "workspace") renderaWorkspace();
        if (v === "positionera") renderaPositioneringPanel();
        if (v === "installningar") renderaInstallningarPanel();
      }

      document.querySelectorAll(".verktygsknapp").forEach((b) => {
        b.addEventListener("click", () => bytVerktyg((b as HTMLElement).dataset.verktyg as any));
      });

      function nastaZIndex(): number {
        const sida = hittaAktivSida();
        const max = sida.element.reduce((m, e) => Math.max(m, e.zIndex ?? 1), 0);
        return max + 1;
      }

      function skapaNyttElement(typ: "box" | "text" | "bild" | "knapp" | "scroll" | "grid" | "input") {
        const sida = hittaAktivSida();
        const antal = sida.element.filter((e) => e.typ === typ).length + 1;
        const z = nastaZIndex();
        let nytt: ManuellElement;
        if (typ === "box") {
          nytt = { id: skapaId(), typ, namn: `Box ${antal}`, x: 40, y: 40, bredd: 160, hojd: 100, bakgrund: "#f3f1ea", zIndex: z, cursor: "default" };
        } else if (typ === "text") {
          nytt = { ...skapaTextEl(`Text ${antal}`, 40, 40, 200, 40, "Ny text"), zIndex: z, cursor: "default" };
        } else if (typ === "bild") {
          nytt = { id: skapaId(), typ, namn: `Bild ${antal}`, x: 40, y: 40, bredd: 220, hojd: 160, bildUrl: "https://placehold.co/400x300/f3f1ea/9aa2b6?text=Bild", bildFit: "cover", zIndex: z, cursor: "default" };
        } else if (typ === "knapp") {
          nytt = { id: skapaId(), typ, namn: `Knapp ${antal}`, x: 40, y: 40, bredd: 150, hojd: 46, text: "Knapp", bakgrund: "#ffb238", textFarg: "#10141c", zIndex: z, cursor: "pointer" };
        } else if (typ === "scroll") {
          nytt = { id: skapaId(), typ, namn: `Scrollbar yta ${antal}`, x: 40, y: 40, bredd: 280, hojd: 200, bakgrund: "#f3f1ea", kantbredd: 1, kantfarg: "#e4e0d4", text: "Post ett\nPost två\nPost tre\nPost fyra", zIndex: z, cursor: "default" };
        } else if (typ === "grid") {
          nytt = { id: skapaId(), typ, namn: `Gridsystem ${antal}`, x: 40, y: 40, bredd: 360, hojd: 220, gridKolumner: 3, gridRader: 2, gridMellanrum: 12, gridCellFarg: "#ffffff", zIndex: z, cursor: "default" };
        } else {
          nytt = { id: skapaId(), typ, namn: `Inmatningsfält ${antal}`, x: 40, y: 40, bredd: 240, hojd: 44, platshallareText: "Skriv något …", bakgrund: "#ffffff", kantbredd: 1, kantfarg: "#d8d4c8", zIndex: z, cursor: "text" };
        }

        sida.element.unshift(nytt);
        valtElementId = nytt.id;
        renderaForhandsvisning();
        bytVerktyg("egenskaper");
        markeraOsparat();
      }

      document.getElementById("lagg-till-box")!.addEventListener("click", () => skapaNyttElement("box"));
      document.getElementById("lagg-till-text")!.addEventListener("click", () => skapaNyttElement("text"));
      document.getElementById("lagg-till-bild")!.addEventListener("click", () => skapaNyttElement("bild"));
      document.getElementById("lagg-till-knapp-el")!.addEventListener("click", () => skapaNyttElement("knapp"));
      document.getElementById("lagg-till-scroll")!.addEventListener("click", () => skapaNyttElement("scroll"));
      document.getElementById("lagg-till-grid")!.addEventListener("click", () => skapaNyttElement("grid"));
      document.getElementById("lagg-till-input")!.addEventListener("click", () => skapaNyttElement("input"));

      function skapaSektionsrubrik(container: HTMLElement, text: string, oppenStandard = true) {
        const sektion = document.createElement("div");
        sektion.className = "insp-sektion" + (oppenStandard ? " oppen" : "");

        const rubrik = document.createElement("button");
        rubrik.type = "button";
        rubrik.className = "insp-sektion-rubrik";
        rubrik.innerHTML = `<span class="insp-sektion-pil">▸</span><span>${text}</span>`;

        const kropp = document.createElement("div");
        kropp.className = "insp-sektion-kropp";

        rubrik.addEventListener("click", () => {
          sektion.classList.toggle("oppen");
        });

        sektion.appendChild(rubrik);
        sektion.appendChild(kropp);
        container.appendChild(sektion);
        return kropp;
      }

      function skapaRadGrupp(container: HTMLElement, ...rader: HTMLElement[]) {
        const grupp = document.createElement("div");
        grupp.className = "insp-radgrupp";
        rader.forEach((r) => grupp.appendChild(r));
        container.appendChild(grupp);
      }

      function skapaFalt(
        container: HTMLElement,
        etikett: string,
        initialt: string,
        uppdatera: (varde: string) => void,
        liveUppdatera: () => void,
        installningar?: { typ?: "text" | "number" | "color" | "textarea" | "range"; id?: string; min?: number; max?: number; steg?: number; kompakt?: boolean; platshallare?: string }
      ): HTMLElement {
        const typ = installningar?.typ || "text";
        const rad = document.createElement("label");
        rad.className = "insp-falt" + (installningar?.kompakt ? " insp-falt-kompakt" : "");
        rad.dataset.etikett = etikett.toLowerCase();

        const huvud = document.createElement("div");
        huvud.className = "insp-falt-huvud";
        const span = document.createElement("span");
        span.textContent = etikett;
        huvud.appendChild(span);

        let vardeVisning: HTMLElement | null = null;
        if (typ === "range") {
          vardeVisning = document.createElement("span");
          vardeVisning.className = "insp-vardevisning";
          vardeVisning.textContent = initialt;
          vardeVisning.title = "Klicka för att skriva in ett exakt värde";
          huvud.appendChild(vardeVisning);
        }
        rad.appendChild(huvud);

        const arText = typ === "textarea";
        const faltEl: HTMLInputElement | HTMLTextAreaElement = arText
          ? document.createElement("textarea")
          : document.createElement("input");
        if (!arText) {
          (faltEl as HTMLInputElement).type = typ === "range" ? "range" : typ;
          if (typ === "range") {
            if (installningar?.min !== undefined) (faltEl as HTMLInputElement).min = String(installningar.min);
            if (installningar?.max !== undefined) (faltEl as HTMLInputElement).max = String(installningar.max);
            if (installningar?.steg !== undefined) (faltEl as HTMLInputElement).step = String(installningar.steg);
          }
        }
        if (installningar?.id) faltEl.id = installningar.id;
        if (installningar?.platshallare) faltEl.setAttribute("placeholder", installningar.platshallare);
        faltEl.value = initialt;
        faltEl.addEventListener("input", () => {
          uppdatera(faltEl.value);
          if (vardeVisning) vardeVisning.textContent = faltEl.value;
          liveUppdatera();
          markeraOsparat();
        });

        if (typ === "range" && vardeVisning) {
          vardeVisning.addEventListener("click", () => {
            const nuvarandeVarde = faltEl.value;
            const input = document.createElement("input");
            input.type = "number";
            input.className = "insp-vardevisning-input";
            if (installningar?.min !== undefined) input.min = String(installningar.min);
            if (installningar?.max !== undefined) input.max = String(installningar.max);
            if (installningar?.steg !== undefined) input.step = String(installningar.steg);
            input.value = nuvarandeVarde;
            vardeVisning!.replaceWith(input);
            input.focus();
            input.select();

            const commit = () => {
              let nytt = Number(input.value);
              if (Number.isNaN(nytt)) nytt = Number(nuvarandeVarde) || 0;
              if (installningar?.min !== undefined) nytt = Math.max(installningar.min, nytt);
              if (installningar?.max !== undefined) nytt = Math.min(installningar.max, nytt);
              (faltEl as HTMLInputElement).value = String(nytt);
              uppdatera(String(nytt));
              liveUppdatera();
              markeraOsparat();
              const nyttSpan = document.createElement("span");
              nyttSpan.className = "insp-vardevisning";
              nyttSpan.title = "Klicka för att skriva in ett exakt värde";
              nyttSpan.textContent = String(nytt);
              input.replaceWith(nyttSpan);
              vardeVisning = nyttSpan;
              vardeVisning.addEventListener("click", () => vardeVisning!.dispatchEvent(new Event("__oppna")));
            };
            input.addEventListener("keydown", (e) => {
              if (e.key === "Enter") { e.preventDefault(); input.blur(); }
              if (e.key === "Escape") { e.preventDefault(); input.value = nuvarandeVarde; input.blur(); }
            });
            input.addEventListener("blur", commit);
          });
        }

        rad.appendChild(faltEl);
        container.appendChild(rad);
        return rad;
      }

      function skapaVal(
        container: HTMLElement,
        etikett: string,
        initialt: string,
        alternativ: [string, string][],
        uppdatera: (varde: string) => void,
        liveUppdatera: () => void
      ): HTMLElement {
        const rad = document.createElement("label");
        rad.className = "insp-falt insp-falt-kompakt";
        rad.dataset.etikett = etikett.toLowerCase();
        const span = document.createElement("span");
        span.textContent = etikett;
        const select = document.createElement("select");
        alternativ.forEach(([varde, text]) => {
          const opt = document.createElement("option");
          opt.value = varde;
          opt.textContent = text;
          if (varde === initialt) opt.selected = true;
          select.appendChild(opt);
        });
        select.addEventListener("change", () => {
          uppdatera(select.value);
          liveUppdatera();
          markeraOsparat();
        });
        rad.appendChild(span);
        rad.appendChild(select);
        container.appendChild(rad);
        return rad;
      }

      function skapaSegmentVal(
        container: HTMLElement,
        etikett: string,
        initialt: string,
        alternativ: [string, string][],
        uppdatera: (varde: string) => void,
        liveUppdatera: () => void
      ): HTMLElement {
        const rad = document.createElement("div");
        rad.className = "insp-falt insp-falt-kompakt";
        rad.dataset.etikett = etikett.toLowerCase();
        const span = document.createElement("span");
        span.textContent = etikett;
        const segment = document.createElement("div");
        segment.className = "insp-segment";
        alternativ.forEach(([varde, label]) => {
          const knapp = document.createElement("button");
          knapp.type = "button";
          knapp.textContent = label;
          knapp.className = "insp-segment-knapp" + (varde === initialt ? " aktiv" : "");
          knapp.addEventListener("click", () => {
            segment.querySelectorAll(".insp-segment-knapp").forEach((b) => b.classList.remove("aktiv"));
            knapp.classList.add("aktiv");
            uppdatera(varde);
            liveUppdatera();
            markeraOsparat();
          });
          segment.appendChild(knapp);
        });
        rad.appendChild(span);
        rad.appendChild(segment);
        container.appendChild(rad);
        return rad;
      }

      function skapaKryssruta(
        container: HTMLElement,
        etikett: string,
        initialt: boolean,
        uppdatera: (varde: boolean) => void,
        liveUppdatera: () => void
      ): HTMLElement {
        const rad = document.createElement("label");
        rad.className = "insp-falt insp-falt-kompakt insp-falt-kryss";
        rad.dataset.etikett = etikett.toLowerCase();
        const span = document.createElement("span");
        span.textContent = etikett;
        const input = document.createElement("input");
        input.type = "checkbox";
        input.checked = initialt;
        input.addEventListener("change", () => {
          uppdatera(input.checked);
          liveUppdatera();
          markeraOsparat();
        });
        rad.appendChild(span);
        rad.appendChild(input);
        container.appendChild(rad);
        return rad;
      }

      const elementTypNamn: Record<ManuellElement["typ"], string> = {
        box: "Box", text: "Text", bild: "Bild", knapp: "Knapp", scroll: "Scrollbar yta", grid: "Gridsystem", input: "Inmatningsfält",
      };

      function filtreraEgenskaper(sokterm: string) {
        const container = document.getElementById("egenskaper-innehall") as HTMLElement;
        const term = sokterm.trim().toLowerCase();
        const sektioner = container.querySelectorAll(".insp-sektion");
        sektioner.forEach((sektion) => {
          const falt = sektion.querySelectorAll<HTMLElement>("[data-etikett]");
          let nagonSynlig = false;
          falt.forEach((f) => {
            const traff = !term || (f.dataset.etikett || "").includes(term);
            f.style.display = traff ? "" : "none";
            const grupp = f.closest(".insp-radgrupp") as HTMLElement | null;
            if (grupp) grupp.style.display = "";
            if (traff) nagonSynlig = true;
          });
          container.querySelectorAll(".insp-radgrupp").forEach((grupp) => {
            const g = grupp as HTMLElement;
            const synligaBarn = Array.from(g.querySelectorAll<HTMLElement>("[data-etikett]")).some((f) => f.style.display !== "none");
            g.style.display = synligaBarn ? "" : "none";
          });
          (sektion as HTMLElement).style.display = nagonSynlig || !term ? "" : "none";
          if (term && nagonSynlig) sektion.classList.add("oppen");
        });
      }

