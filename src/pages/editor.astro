---
const sidTitel = "Webbsida redigerare - WesbiqAI";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{sidTitel}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="editor-shell">
      <header class="editor-topbar">
        <div class="wrap topbar-row">
          <a href="/" class="logo" aria-label="Websiq AI hem">
            <span class="logo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="logo-text">Web<span class="accent">siq</span> AI</span>
          </a>
          <span class="topbar-title">Webbsida redigerare</span>
          <a href="/" class="back-link">← Till startsidan</a>
        </div>
      </header>

      <div class="editor-main">
        <section class="preview-wrap">
          <div class="preview-toolbar">
            <span class="preview-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="url-oval" id="url-oval">
              <span class="url-oval-lock" aria-hidden="true">🔒</span>
              <span class="url-oval-text" id="url-oval-text">dittforetag.websiq.se</span>
              <button class="url-oval-cog" id="url-oval-cog" type="button" aria-label="Ändra domän" title="Ändra domän">⚙</button>
            </div>
            <div class="spara-omrade">
              <button id="spara-knapp" class="spara-knapp" type="button">
                <span id="spara-status-text">Spara</span>
              </button>
            </div>
          </div>
          <div class="preview-frame-holder">
            <iframe
              id="preview-frame"
              class="preview-frame"
              title="Renderad Astro-sida"
              loading="eager"
            ></iframe>
          </div>
        </section>

        <div class="chat-dock">
          <aside class="verktygspanel-yta">
            <div class="verktygsfalt">
              <button class="verktygsknapp aktiv" type="button" data-verktyg="ai" title="AI-assistent">
                <span class="ikon">✦</span>AI
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="element" title="Element">
                <span class="ikon">▭</span>Element
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="egenskaper" title="Egenskaper">
                <span class="ikon">⚙</span>Egensk.
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="sidor" title="Sidor">
                <span class="ikon">▤</span>Sidor
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="workspace" title="Workspace">
                <span class="ikon">▦</span>Workspace
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="services" title="Services">
                <span class="ikon">◈</span>Services
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="positionera" title="Positionera">
                <span class="ikon">⌖</span>Position
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="molnbackuper" title="Molnbackuper">
                <span class="ikon">☁</span>Backup
              </button>
              <button class="verktygsknapp" type="button" data-verktyg="installningar" title="Inställningar">
                <span class="ikon">⚙</span>Inställn.
              </button>
            </div>

            <div class="verktygsinnehall">
              <div class="verktygshuvud">
                <span class="ai-dot" aria-hidden="true"></span>
                <span id="verktyg-titel">AI-assistent</span>
              </div>

              <div id="panel-ai" class="panel-vy aktiv">
                <div class="ai-token-rad">
                  <span id="ai-token-status"></span>
                  <button id="chat-rensa-knapp" class="chat-ny-knapp" type="button">Rensa konversation</button>
                </div>
                <div id="chat-messages" class="chat-messages"></div>
                <div class="chat-input-row">
                  <textarea
                    id="ai-prompt"
                    placeholder="Beskriv sidan du vill se, t.ex. 'gör en prissektion'..."
                    rows="3"
                  ></textarea>
                  <button id="ai-send" class="btn btn-primary" type="button">Skicka</button>
                </div>
              </div>

              <div id="panel-element" class="panel-vy">
                <p class="panel-info">Lägg till ett element på den aktiva sidan.</p>
                <div class="element-knapprad">
                  <button id="lagg-till-box" class="element-knapp" type="button">
                    <span class="ikon">▭</span>Box
                  </button>
                  <button id="lagg-till-text" class="element-knapp" type="button">
                    <span class="ikon">T</span>Text
                  </button>
                  <button id="lagg-till-bild" class="element-knapp" type="button">
                    <span class="ikon">🖼</span>Bild
                  </button>
                  <button id="lagg-till-knapp-el" class="element-knapp" type="button">
                    <span class="ikon">▢</span>Knapp
                  </button>
                  <button id="lagg-till-scroll" class="element-knapp" type="button">
                    <span class="ikon">⇕</span>Scrollbar yta
                  </button>
                  <button id="lagg-till-grid" class="element-knapp" type="button">
                    <span class="ikon">▦</span>Gridsystem
                  </button>
                  <button id="lagg-till-input" class="element-knapp" type="button">
                    <span class="ikon">⌤</span>Inmatningsfält
                  </button>
                </div>
              </div>

              <div id="panel-egenskaper" class="panel-vy">
                <div id="egenskaper-innehall"></div>
              </div>

              <div id="panel-sidor" class="panel-vy">
                <p class="panel-info">Hantera sidorna i projektet. Klicka på en sida för att göra den aktiv.</p>
                <div class="sidor-lista-vertikal" id="sidor-lista-vertikal"></div>
                <div class="element-knapprad sidor-lagg-till-rad">
                  <button id="sidor-lagg-till-knapp" class="element-knapp" type="button">
                    <span class="ikon">+</span>Lägg till sida
                  </button>
                </div>
              </div>

              <div id="panel-workspace" class="panel-vy">
                <div class="ws-element-header">Element på sidan</div>
                <div id="workspace-lista"></div>
              </div>

              <div id="panel-services" class="panel-vy">
                <p class="panel-info">Extra funktioner för din sida.</p>
                <div class="element-knapprad" id="services-knapprad">
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Bokningssystem">
                    <span class="ikon">▭</span>Bokningssystem
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Inlogg för personal">
                    <span class="ikon">▭</span>Inlogg för personal
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Inlogg för kunder">
                    <span class="ikon">▭</span>Inlogg för kunder
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Kundhistorik">
                    <span class="ikon">▭</span>Kundhistorik
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Automatiska mail">
                    <span class="ikon">▭</span>Automatiska mail
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Push notiser">
                    <span class="ikon">▭</span>Push notiser
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Gör till app">
                    <span class="ikon">▭</span>Gör till app
                  </button>
                  <button class="element-knapp tjanst-knapp" type="button" data-tjanst="Statistik">
                    <span class="ikon">▭</span>Statistik
                  </button>
                </div>
                <div id="services-detalj" class="services-detalj"></div>
              </div>

              <div id="panel-positionera" class="panel-vy">
                <p class="panel-info">Positionera det valda elementet på sidan.</p>
                <div id="positionera-innehall"></div>
              </div>

              <div id="panel-molnbackuper" class="panel-vy">
                <p class="panel-info">Molnbackuper — kommer snart.</p>
              </div>

              <div id="panel-installningar" class="panel-vy">
                <p class="panel-info">Projektinställningar.</p>
                <div id="installningar-innehall"></div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <script>
      interface ManuellElement {
        id: string;
        typ: "box" | "text" | "bild" | "knapp" | "scroll" | "grid" | "input";
        namn: string;
        x: number;
        y: number;
        bredd: number;
        hojd: number;
        text?: string;
        bakgrund?: string;
        rotation?: number;
        radie?: number;
        opacitet?: number;
        zIndex?: number;
        textFarg?: string;
        fontStorlek?: number;
        fontVikt?: string;
        textAlign?: "left" | "center" | "right";
        kantfarg?: string;
        kantbredd?: number;
        kantstil?: "solid" | "dashed" | "dotted";
        skugga?: boolean;
        skuggaFarg?: string;
        skuggaX?: number;
        skuggaY?: number;
        skuggaBlur?: number;
        skuggaSpridning?: number;
        skuggaOpacitet?: number;
        bildUrl?: string;
        bildFit?: "cover" | "contain";
        lank?: string;
        bokstavsMellanrum?: number;
        radavstand?: number;
        blandningslage?: string;
        cursor?: string;
        overflowDold?: boolean;
        laast?: boolean;
        glasEffekt?: boolean;
        glasStyrka?: number;
        gradient?: boolean;
        gradientFarg2?: string;
        gradientVinkel?: number;
        textskugga?: boolean;
        understruken?: boolean;
        hoverSkala?: number;
        hoverBakgrund?: string;
        gridKolumner?: number;
        gridRader?: number;
        gridMellanrum?: number;
        gridCellFarg?: string;
        gridCellHojd?: number;
        platshallareText?: string;
        skaladText?: boolean;
      }

      enum Plan {
        None = "none",
        Start = "start",
        Pro = "pro",
        Premium = "premium",
      }

      const PLAN_MAX_SIDOR: Record<Plan, number> = {
        [Plan.None]: 5,
        [Plan.Start]: 5,
        [Plan.Pro]: 15,
        [Plan.Premium]: 25,
      };

      let aktivPlan: Plan = Plan.None;

      function maxTillatnaSidor(): number {
        return PLAN_MAX_SIDOR[aktivPlan];
      }

      function skapaId(): string {
        return "s" + Math.random().toString(36).slice(2, 9);
      }

      function skapaTextEl(namn: string, x: number, y: number, bredd: number, hojd: number, text: string): ManuellElement {
        return {
          id: skapaId(),
          typ: "text",
          namn,
          x,
          y,
          bredd,
          hojd,
          text,
          textAlign: "center",
          bakgrund: "transparent",
        };
      }

      function skapaBoxEl(namn: string, x: number, y: number, bredd: number, hojd: number, bakgrund: string): ManuellElement {
        return { id: skapaId(), typ: "box", namn, x, y, bredd, hojd, bakgrund };
      }

      function mallHero(): ManuellElement[] {
        const el: ManuellElement[] = [];
        el.push(skapaTextEl("Etikett", 48, 40, 300, 22, "Ny sida"));
        el.push(skapaTextEl("Rubrik", 48, 68, 520, 50, "Bygg snabbare med Astro"));
        const punkter = ["Blixtsnabbt", "Noll onödig JS", "Enkelt att lära"];
        punkter.forEach((p, i) => {
          const x = 48 + i * 168;
          el.push(skapaBoxEl(`Pill ${i + 1}`, x, 136, 152, 36, "#ffffff"));
          el.push(skapaTextEl(`Pill ${i + 1} text`, x, 136, 152, 36, p));
        });
        el.push(skapaBoxEl("Knapp", 48, 192, 150, 46, "#ffb238"));
        el.push(skapaTextEl("Knapp text", 48, 192, 150, 46, "Kom igång"));
        return el;
      }

      function mallFunktioner(): ManuellElement[] {
        const el: ManuellElement[] = [];
        el.push(skapaTextEl("Rubrik", 48, 24, 400, 32, "Vad du får"));
        const data: [string, string][] = [
          ["Snabb rendering", "Sidor byggs statiskt och laddas direkt."],
          ["Komponenter", "Återanvänd byggblock över hela sajten."],
          ["Noll konfiguration", "Kom igång utan komplicerad uppsättning."],
        ];
        data.forEach(([titel, text], i) => {
          const x = 48 + i * 272;
          el.push(skapaBoxEl(`Kort ${i + 1}`, x, 72, 252, 150, "#ffffff"));
          el.push(skapaTextEl(`Kort ${i + 1} titel`, x + 16, 88, 220, 26, titel));
          el.push(skapaTextEl(`Kort ${i + 1} text`, x + 16, 118, 220, 90, text));
        });
        return el;
      }

      function mallPriser(): ManuellElement[] {
        const el: ManuellElement[] = [];
        el.push(skapaTextEl("Rubrik", 48, 24, 300, 32, "Priser"));
        const data: [string, string, string][] = [
          ["Start", "0 kr", "För hobbyprojekt"],
          ["Pro", "199 kr", "För växande team"],
          ["Enterprise", "Kontakta oss", "Skräddarsytt"],
        ];
        data.forEach(([namn, pris, detalj], i) => {
          const x = 48 + i * 240;
          el.push(skapaBoxEl(`Plan ${i + 1}`, x, 72, 220, 180, "#ffffff"));
          el.push(skapaTextEl(`Plan ${i + 1} namn`, x + 16, 88, 188, 26, namn));
          el.push(skapaTextEl(`Plan ${i + 1} pris`, x + 16, 118, 188, 32, pris));
          el.push(skapaTextEl(`Plan ${i + 1} detalj`, x + 16, 156, 188, 60, detalj));
        });
        return el;
      }

      function mallKontakt(): ManuellElement[] {
        const el: ManuellElement[] = [];
        el.push(skapaTextEl("Rubrik", 48, 24, 300, 32, "Hör av dig"));
        const falt = ["Namn", "E-post", "Meddelande"];
        falt.forEach((f, i) => {
          const y = 76 + i * 64;
          el.push(skapaTextEl(`${f} etikett`, 48, y, 200, 22, f));
          el.push(skapaBoxEl(`${f} fält`, 48, y + 24, 360, 34, "#ffffff"));
        });
        const yBtn = 76 + falt.length * 64 + 10;
        el.push(skapaBoxEl("Skicka-knapp", 48, yBtn, 140, 44, "#ffb238"));
        el.push(skapaTextEl("Skicka text", 48, yBtn, 140, 44, "Skicka"));
        return el;
      }

      interface AiMall {
        nyckelord: string[];
        titel: string;
        skapaElement: () => ManuellElement[];
      }

      const aiMallar: AiMall[] = [
        { nyckelord: ["hero", "landning", "landing", "start", "hem"], titel: "landningssektion", skapaElement: mallHero },
        { nyckelord: ["funktion", "features", "feature", "kort"], titel: "funktionssektion", skapaElement: mallFunktioner },
        { nyckelord: ["pris", "priser", "pricing", "plan", "abonnemang"], titel: "prissektion", skapaElement: mallPriser },
        { nyckelord: ["kontakt", "contact", "formulär", "form"], titel: "kontaktsektion", skapaElement: mallKontakt },
      ];

      function valjMall(prompt: string): AiMall {
        const p = prompt.toLowerCase();
        return aiMallar.find((m) => m.nyckelord.some((n) => p.includes(n))) || aiMallar[0];
      }

      function escapeHtml(text: string): string {
        return text.replace(/[&<>"']/g, (ch) =>
          (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }) as Record<string, string>)[ch]
        );
      }

      function normaliseraSidnamn(namn: string): string {
        return namn.trim().toLowerCase().replace(/\.astro$/, "");
      }

      function hittaSidaViaNamn(namn: string): Sida | undefined {
        const mal = normaliseraSidnamn(namn);
        return sidor.find((s) => normaliseraSidnamn(s.namn) === mal);
      }

      function renderaScrollInnehall(el: ManuellElement): string {
        const poster = (el.text || "Post ett\nPost två\nPost tre").split("\n").filter((p) => p.trim().length);
        const farg = el.textFarg || "#10141c";
        const storlek = el.fontStorlek ?? 15;
        return poster
          .map(
            (p) =>
              `<div style="background:#ffffff;border:1px solid #e4e0d4;border-radius:10px;padding:12px 14px;margin-bottom:10px;font-family:'Inter',sans-serif;font-size:${storlek}px;color:${farg};box-shadow:0 4px 14px -8px rgba(15,20,32,0.25);">${escapeHtml(p)}</div>`
          )
          .join("");
      }

      function renderaGridCeller(el: ManuellElement): string {
        const kolumner = Math.max(1, el.gridKolumner ?? 3);
        const rader = Math.max(1, el.gridRader ?? 2);
        const antal = kolumner * rader;
        const farg = el.gridCellFarg || "#ffffff";
        let celler = "";
        for (let i = 0; i < antal; i++) {
          celler += `<div style="background:${farg};border-radius:8px;min-height:0;"></div>`;
        }
        return celler;
      }

      function renderaElementHtml(el: ManuellElement): string {
        const rotation = el.rotation ?? 0;
        const radie = el.radie ?? 0;
        const opacitet = (el.opacitet ?? 100) / 100;
        const zIndex = el.zIndex ?? 1;
        const blandning = el.blandningslage || "normal";
        const cursorVarde = el.cursor || "default";
        const overflow = el.overflowDold ? "hidden" : "visible";
        const skuggaCss = el.skugga
          ? `box-shadow:${el.skuggaX ?? 0}px ${el.skuggaY ?? 14}px ${el.skuggaBlur ?? 24}px ${el.skuggaSpridning ?? -6}px ${el.skuggaFarg || "rgba(0,0,0,0.55)"};`
          : "";
        const glasCss = el.glasEffekt ? `backdrop-filter:blur(${el.glasStyrka ?? 10}px);-webkit-backdrop-filter:blur(${el.glasStyrka ?? 10}px);` : "";
        const kantstil = el.kantstil || "solid";
        const bas = `position:absolute;left:${el.x}px;top:${el.y}px;width:${el.bredd}px;height:${el.hojd}px;transform:rotate(${rotation}deg);border-radius:${radie}px;opacity:${opacitet};z-index:${zIndex};mix-blend-mode:${blandning};overflow:${overflow};${glasCss}`;

        function bakgrundCss(farg: string | undefined, fallback: string): string {
          if (el.gradient) {
            return `background:linear-gradient(${el.gradientVinkel ?? 135}deg, ${farg || fallback}, ${el.gradientFarg2 || "#7c93ff"});`;
          }
          return `background:${farg || fallback};`;
        }

        if (el.typ === "text") {
          const farg = el.textFarg || "#10141c";
          const storlek = el.fontStorlek ?? 16;
          const vikt = el.fontVikt || "400";
          const justering = el.textAlign || "center";
          const justeringFlex = justering === "center" ? "center" : justering === "right" ? "flex-end" : "flex-start";
          const bakgrund = el.bakgrund && el.bakgrund !== "transparent" ? el.bakgrund : "transparent";
          const bokstavsMellanrum = el.bokstavsMellanrum ?? 0;
          const radavstand = el.radavstand ?? 1.3;
          const understruken = el.understruken ? "underline" : "none";
          const textskuggaCss = el.textskugga ? "text-shadow:0 3px 10px rgba(0,0,0,0.4);" : "";
          const skaladTextAttr = el.skaladText ? ` data-skalad-text="1"` : "";
          return `<div data-el-id="${el.id}"${skaladTextAttr} style="${bas}background:${bakgrund};font-family:'Inter',sans-serif;font-size:${storlek}px;font-weight:${vikt};color:${farg};text-align:${justering};letter-spacing:${bokstavsMellanrum}px;line-height:${radavstand};text-decoration:${understruken};${textskuggaCss}display:flex;align-items:center;justify-content:${justeringFlex};padding:0 6px;cursor:${cursorVarde};-webkit-user-select:none;user-select:none;">${escapeHtml(el.text || "")}</div>`;
        }

        if (el.typ === "bild") {
          const bildUrl = el.bildUrl || "https://placehold.co/400x300/f3f1ea/9aa2b6?text=Bild";
          const fit = el.bildFit || "cover";
          const kantbredd = el.kantbredd ?? 0;
          const kantfarg = el.kantfarg || "transparent";
          return `<div data-el-id="${el.id}" style="${bas}${skuggaCss}border:${kantbredd}px ${kantstil} ${kantfarg};cursor:${cursorVarde};-webkit-user-select:none;user-select:none;"><img src="${escapeHtml(bildUrl)}" alt="" draggable="false" style="width:100%;height:100%;object-fit:${fit};display:block;pointer-events:none;" /></div>`;
        }

        if (el.typ === "knapp") {
          const farg = el.textFarg || "#10141c";
          const storlek = el.fontStorlek ?? 16;
          const vikt = el.fontVikt || "600";
          const bokstavsMellanrum = el.bokstavsMellanrum ?? 0;
          const understruken = el.understruken ? "underline" : "none";
          const lankAttr = el.lank ? ` data-lank-sida="${escapeHtml(el.lank)}"` : "";
          return `<div data-el-id="${el.id}"${lankAttr} style="${bas}${skuggaCss}${bakgrundCss(el.bakgrund, "#ffb238")}font-family:'Inter',sans-serif;font-size:${storlek}px;font-weight:${vikt};color:${farg};letter-spacing:${bokstavsMellanrum}px;text-decoration:${understruken};display:flex;align-items:center;justify-content:center;cursor:${cursorVarde};-webkit-user-select:none;user-select:none;">${escapeHtml(el.text || "Knapp")}</div>`;
        }

        if (el.typ === "scroll") {
          const bakgrund = el.bakgrund || "#f3f1ea";
          const kantbredd = el.kantbredd ?? 1;
          const kantfarg = el.kantfarg || "#e4e0d4";
          return `<div data-el-id="${el.id}" style="${bas}${skuggaCss}background:${bakgrund};border:${kantbredd}px ${kantstil} ${kantfarg};overflow-y:auto;scrollbar-width:thin;cursor:${cursorVarde};"><div style="padding:14px;">${renderaScrollInnehall(el)}</div></div>`;
        }

        if (el.typ === "grid") {
          const kolumner = Math.max(1, el.gridKolumner ?? 3);
          const rader = Math.max(1, el.gridRader ?? 2);
          const mellanrum = el.gridMellanrum ?? 12;
          const cellHojd = el.gridCellHojd ? `grid-auto-rows:${el.gridCellHojd}px;` : "";
          return `<div data-el-id="${el.id}" style="${bas}${skuggaCss}${bakgrundCss(el.bakgrund, "transparent")}display:grid;grid-template-columns:repeat(${kolumner}, 1fr);grid-template-rows:repeat(${rader}, 1fr);${cellHojd}gap:${mellanrum}px;cursor:${cursorVarde};">${renderaGridCeller(el)}</div>`;
        }

        if (el.typ === "input") {
          const farg = el.textFarg || "#10141c";
          const storlek = el.fontStorlek ?? 15;
          const bakgrund = el.bakgrund || "#ffffff";
          const kantbredd = el.kantbredd ?? 1;
          const kantfarg = el.kantfarg || "#d8d4c8";
          return `<div data-el-id="${el.id}" style="${bas}${skuggaCss}">
            <input type="text" placeholder="${escapeHtml(el.platshallareText || "Skriv något …")}" style="width:100%;height:100%;box-sizing:border-box;background:${bakgrund};color:${farg};font-family:'Inter',sans-serif;font-size:${storlek}px;border:${kantbredd}px ${kantstil} ${kantfarg};border-radius:${radie}px;padding:0 12px;outline:none;" />
          </div>`;
        }

        const kantbredd = el.kantbredd ?? 0;
        const kantfarg = el.kantfarg || "transparent";
        return `<div data-el-id="${el.id}" style="${bas}${skuggaCss}${bakgrundCss(el.bakgrund, "#f3f1ea")}border:${kantbredd}px ${kantstil} ${kantfarg};cursor:${cursorVarde};-webkit-user-select:none;user-select:none;"></div>`;
      }

      function byggHoverStilar(element: ManuellElement[]): string {
        return element
          .filter((el) => (el.hoverSkala && el.hoverSkala !== 100) || el.hoverBakgrund)
          .map((el) => {
            const delar: string[] = [];
            if (el.hoverSkala && el.hoverSkala !== 100) delar.push(`transform:rotate(${el.rotation ?? 0}deg) scale(${el.hoverSkala / 100});`);
            if (el.hoverBakgrund) delar.push(`background:${el.hoverBakgrund};`);
            return `[data-el-id="${el.id}"]:hover{${delar.join("")}}`;
          })
          .join("\n");
      }

      function tomSidaHtml(): string {
        return `<div class="tom-sida">
  <span class="tom-sida-badge">Tom sida</span>
  <div class="tom-sida-ikon" aria-hidden="true">✦</div>
  <h2>Sidan är tom</h2>
  <p>Beskriv sidan du vill se i AI-chatten till höger, eller lägg till ett element manuellt via Element-verktyget.</p>
</div>`;
      }

      function byggForhandsvisningsDokument(element: ManuellElement[], valtElementId: string | null): string {
        const innehall = element.length ? element.map(renderaElementHtml).join("") : tomSidaHtml();
        const valtIdJson = valtElementId ? JSON.stringify(valtElementId) : "null";
        const hoverStilar = byggHoverStilar(element);
        return `<!doctype html>
<html lang="sv">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', system-ui, sans-serif; color: #10141c; background: #f3f1ea; }
  .ws-yta { position: relative; min-height: 100vh; }
  [data-el-id]:hover { outline: 1px dashed rgba(76, 111, 255, 0.45); outline-offset: 2px; }
  .tom-sida {
    min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 16px; text-align: center; padding: 64px 48px;
