---
export const prerender = false;

import { createClient } from "@supabase/supabase-js";
import { getDomain, getPageName } from "../lib/host";

const supabaseUrl = "https://irvboovrbphgeqzsxrlu.supabase.co";

const supabaseKey =
  "sb_publishable_Tf02evMtkz4QqO_n5Qac1Q_O0fxm3Q9";
const supabase = createClient(
  supabaseUrl,
  supabaseKey
);

const domain = getDomain(
  Astro.url.hostname
);

const pageName = getPageName(
  Astro.url.pathname
);

if (!domain) {
  return new Response(
    "Ogiltig domän",
    { status: 404 }
  );
}

const {
  data,
  error
} = await supabase
  .from("live_pages")
  .select("content")
  .eq("domain", domain)
  .eq("name", pageName)
  .maybeSingle();

if (error) {
  console.error(
    "Fel vid hämtning av sida:",
    error
  );

  return new Response(
    "Ett fel uppstod",
    { status: 500 }
  );
}

if (!data) {
  return new Response(
    "Sidan hittades inte",
    { status: 404 }
  );
}

const innehåll = data.content;
---

<div set:html={innehåll}></div>