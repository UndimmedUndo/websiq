<style is:global>
  :root {
    --ink: #0f1420;
    --ink-2: #161d2c;
    --ink-3: #1f273a;
    --paper: #f3f1ea;
    --paper-2: #ffffff;
    --text: #eef0f6;
    --ink-text: #10141c;
    --muted: #9aa2b6;
    --muted-on-paper: #5c6273;
    --blue: #4c6fff;
    --blue-soft: #7c93ff;
    --amber: #ffb238;
    --green: #3ecf7f;
    --line: rgba(255, 255, 255, 0.09);
    --line-on-paper: rgba(15, 20, 32, 0.12);
    --radius: 14px;
    --font-display: "Sora", system-ui, sans-serif;
    --font-body: "Inter", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  body {
    margin: 0;
    background: var(--ink);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    position: relative;
    min-height: 100vh;
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(
      ellipse 80% 60% at 50% 0%,
      black 40%,
      transparent 90%
    );
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
  }

  :focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .accent {
    color: var(--amber);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-soft);
    margin: 0 0 14px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease,
      opacity 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  .btn-primary {
    background: var(--amber);
    color: var(--ink-text);
  }

  .btn-primary:hover {
    background: #ffbf5a;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }

  .btn-ghost:hover {
    border-color: var(--blue-soft);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(15, 20, 32, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin-right: auto;
  }

  .logo-dots {
    display: inline-flex;
    gap: 4px;
  }

  .logo-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    display: inline-block;
  }

  .logo-dots i:nth-child(3) {
    background: var(--amber);
  }

  .logo-text {
    white-space: nowrap;
  }

  .header-tag-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .header-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .header-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    display: inline-block;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .header-status-dot.online {
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(62, 207, 127, 0.18);
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .login-section {
    padding: 96px 0;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
  }

  .login-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .login-copy h1 {
    font-size: clamp(2rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    margin-top: 8px;
  }

  .login-sub {
    color: var(--muted);
    font-size: 1.02rem;
    margin-top: 18px;
    max-width: 40ch;
  }

  .login-card {
    position: relative;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }

  #inloggningsformular {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 316px;
  }

  .namn-falt {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  #inloggningsformular.signup-lage .namn-falt {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .login-btn {
    width: 100%;
    margin-top: 6px;
  }

  .login-status {
    min-height: 1.1em;
    font-size: 0.88rem;
    color: #ff8a7a;
  }

  .auth-tabs {
    display: flex;
    gap: 6px;
    padding: 4px;
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .auth-tab {
    flex: 1;
    padding: 9px 10px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 7px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .auth-tab.active {
    background: var(--ink-3);
    color: var(--text);
  }

  .auth-tab:hover:not(.active) {
    color: var(--text);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-size: 0.85rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .field input,
  .field select {
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 11px 12px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--blue-soft);
  }

  .field-hint {
    font-size: 0.78rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .success-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--ink-2);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .success-overlay.show {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .success-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--green);
  }

  .success-sub {
    font-size: 0.88rem;
    color: var(--muted);
    max-width: 30ch;
  }

  .success-check {
    width: 58px;
    height: 58px;
    overflow: visible;
  }

  .success-check-circle {
    stroke: var(--green);
    stroke-width: 2;
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: successCircle 0.5s ease forwards;
  }

  .success-check-mark {
    stroke: var(--green);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 36;
    stroke-dashoffset: 36;
    animation: successMark 0.3s ease 0.4s forwards;
  }

  @keyframes successCircle {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes successMark {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .success-check-circle,
    .success-check-mark {
      animation: none;
      stroke-dashoffset: 0;
    }

    .success-overlay {
      transition: none;
    }
  }

  .section {
    padding: 80px 0;
  }

  .section-head {
    max-width: 60ch;
    margin-bottom: 32px;
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .admin-sub {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 8px;
  }

  .admin-cards {
