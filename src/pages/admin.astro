    padding: 8px 0;
    margin-bottom: 18px;
    transition: color 0.15s ease;
  }

  .back-btn:hover {
    color: var(--text);
  }

  #admin-forms {
    max-width: 480px;
    margin: 0 auto;
  }

  .panel-card {
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .panel-card h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .panel-status {
    min-height: 1.1em;
    font-size: 0.88rem;
    color: var(--green);
  }

  @media (max-width: 860px) {
    .login-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .wrap {
      padding: 0 16px;
    }

    .header-row {
      height: 64px;
    }

    .login-section {
      padding: 56px 0;
    }

    .login-card {
      padding: 22px;
    }

    .section {
      padding: 56px 0;
    }

    .admin-cards {
      grid-template-columns: 1fr;
    }

    .action-card,
    .panel-card,
    .no-access {
      padding: 20px;
    }
  }
</style>

<script>
  import { createClient } from "@supabase/supabase-js";

  const supabaseUrl = "https://irvboovrbphgeqzsxrlu.supabase.co";
  const supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlydmJvb3ZyYnBoZ2VxenN4cmx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ2MjUxMTQsImV4cCI6MjEwMDIwMTExNH0.F-GrC5Q7y8NzakNOYTFlDvMvLy_tHCGMtXtjJ0-jEXw";
  const supabase = createClient(supabaseUrl, supabaseKey);

  const AGARE_UUID = "af874aa5-883b-477a-b505-a1b471fd4091";

  const vyInloggning = document.getElementById("vy-inloggning") as HTMLElement;
  const vyAdmin = document.getElementById("vy-admin") as HTMLElement;
  const rubrikTagg = document.getElementById("header-tag") as HTMLElement;
  const statusPrick = document.getElementById("header-status-dot") as HTMLElement;

  const loginTitel = document.getElementById("login-titel") as HTMLElement;
  const loginUndertext = document.getElementById("login-undertext") as HTMLElement;

  const inloggningsformular = document.getElementById(
    "inloggningsformular"
  ) as HTMLFormElement;

  const loginKnapp = document.getElementById(
    "login-knapp"
  ) as HTMLButtonElement;

  const loginStatus = document.getElementById(
    "login-status"
  ) as HTMLElement;

  const losenordHint = document.getElementById(
    "losenord-hint"
  ) as HTMLElement;

  const namnInput = document.getElementById(
    "namn"
  ) as HTMLInputElement;

  const tabLogin = document.getElementById(
    "tab-login"
  ) as HTMLButtonElement;

  const tabSignup = document.getElementById(
    "tab-signup"
  ) as HTMLButtonElement;

  const successBadge = document.getElementById(
    "success-badge"
  ) as HTMLElement;

  const successText = document.getElementById(
    "success-text"
  ) as HTMLElement;

  const successSub = document.getElementById(
    "success-sub"
  ) as HTMLElement;

  const adminHub = document.getElementById(
    "admin-hub"
  ) as HTMLElement;

  const adminForms = document.getElementById(
    "admin-forms"
  ) as HTMLElement;

  const adminWelcome = document.getElementById(
    "admin-welcome"
  ) as HTMLElement;

  const adminSub = document.getElementById(
    "admin-sub"
  ) as HTMLElement;

  const noAccessPanel = document.getElementById(
    "no-access-panel"
  ) as HTMLElement;

  const cardForetag = document.getElementById(
    "card-foretag"
  ) as HTMLButtonElement;

  const cardPersonal = document.getElementById(
    "card-personal"
  ) as HTMLButtonElement;

  const cardEditor = document.getElementById(
    "card-editor"
  ) as HTMLButtonElement;

  const cardEditorTitle = document.getElementById(
    "card-editor-title"
  ) as HTMLElement;

  const cardEditorDesc = document.getElementById(
    "card-editor-desc"
  ) as HTMLElement;

  const cardPersonalTitle = document.getElementById(
    "card-personal-title"
  ) as HTMLElement;

  const cardPersonalDesc = document.getElementById(
    "card-personal-desc"
  ) as HTMLElement;

  const personalPanelTitel = document.getElementById(
    "personal-panel-titel"
  ) as HTMLElement;

  const personalForetagsIdFalt = document.getElementById(
    "personal-foretagsid-falt"
  ) as HTMLElement;

  const personalForetagsIdInput = document.getElementById(
    "personal-foretagsid"
  ) as HTMLInputElement;

  const tillbakaBtn = document.getElementById(
    "tillbaka-btn"
  ) as HTMLButtonElement;

  const loggaUtBtn = document.getElementById(
    "logga-ut-btn"
  ) as HTMLButtonElement;

  const foretagFormular = document.getElementById(
    "foretag-panel"
  ) as HTMLFormElement;

  const foretagKnapp = document.getElementById(
    "foretag-knapp"
  ) as HTMLButtonElement;

  const foretagStatus = document.getElementById(
    "foretag-status"
  ) as HTMLElement;

  const personalFormular = document.getElementById(
    "personal-panel"
  ) as HTMLFormElement;

  const personalKnapp = document.getElementById(
    "personal-knapp"
  ) as HTMLButtonElement;

  const personalStatus = document.getElementById(
    "personal-status"
  ) as HTMLElement;

  type AuthLage = "login" | "signup";

  let authLage: AuthLage = "login";
  let arAgare = false;
  let mittForetag: { id: string; name: string } | null = null;

  function hamtaVisningsnamn(
    user:
      | {
          email?: string | null;
          user_metadata?: Record<string, unknown>;
        }
      | null
      | undefined
  ): string {
    const metadata = user?.user_metadata ?? {};

    const namn =
      (metadata.full_name as string | undefined) ||
      (metadata.display_name as string | undefined) ||
      (metadata.name as string | undefined);

    return namn || user?.email || "";
  }

  function satAuthLage(lage: AuthLage) {
    authLage = lage;

    tabLogin.classList.toggle("active", lage === "login");
    tabSignup.classList.toggle("active", lage === "signup");

    tabLogin.setAttribute(
      "aria-selected",
      String(lage === "login")
    );

    tabSignup.setAttribute(
      "aria-selected",
      String(lage === "signup")
    );

    inloggningsformular.classList.toggle(
      "signup-lage",
      lage === "signup"
    );

    namnInput.required = lage === "signup";

    losenordHint.classList.toggle(
      "dold",
      lage !== "signup"
    );

    loginKnapp.textContent =
      lage === "login"
        ? "Logga in"
        : "Skapa konto";

    loginTitel.textContent =
      lage === "login"
        ? "Välkommen tillbaka"
        : "Välkommen! Skapa ett konto";

    loginUndertext.textContent =
      lage === "login"
        ? "Logga in med ditt konto för att hantera företag och personal."
        : "Registrera dig med namn, e-post och lösenord för att få tillgång till adminpanelen.";

    loginStatus.textContent = "";
  }

  function satEditorText() {
    const harAdminTillgang = arAgare || !!mittForetag;

    cardEditorTitle.textContent = harAdminTillgang
      ? "Editor"
      : "Testa på";

    cardEditorDesc.textContent = harAdminTillgang
      ? "Redigera webbsidans design visuellt."
      : "Testa den visuella editorn och bygg din webbsida visuellt.";
  }

  async function ladInBehorighet(userId: string) {
    arAgare = userId === AGARE_UUID;

    const { data: foretag } = await supabase
      .from("companies")
      .select("id, name")
      .eq("owner", userId)
      .maybeSingle();

    mittForetag = foretag ?? null;
  }

  function visaAdminHubben(visningsnamn: string) {
    adminHub.hidden = false;
    adminForms.hidden = true;

    adminWelcome.textContent =
      `Välkommen, ${visningsnamn || "där"}!`;

    if (arAgare && mittForetag) {
      adminSub.textContent =
        `Du är systemägare och hanterar även ${mittForetag.name}.`;
    } else if (arAgare) {
      adminSub.textContent =
        "Du är systemägare för websiqAI.";
    } else if (mittForetag) {
      adminSub.textContent =
        `Du hanterar ${mittForetag.name}.`;
    } else {
      adminSub.textContent =
        "Du kan testa den visuella editorn även utan adminbehörighet.";
    }

    cardForetag.hidden = !arAgare;
    cardPersonal.hidden = !(arAgare || mittForetag);
    cardEditor.hidden = false;

    if (mittForetag) {
      cardPersonalTitle.textContent =
        `Lägg till personal i ${mittForetag.name}`;

      cardPersonalDesc.textContent =
        `Bjud in en ny medarbetare till ${mittForetag.name}.`;

      personalPanelTitel.textContent =
        `Lägg till personal i ${mittForetag.name}`;
    } else {
      cardPersonalTitle.textContent =
        "Lägg till personal";

      cardPersonalDesc.textContent =
        arAgare
          ? "Bjud in en ny medarbetare till valfritt företag."
          : "Bjud in en ny medarbetare.";

      personalPanelTitel.textContent =
        "Lägg till personal";
    }

    personalForetagsIdFalt.hidden = !arAgare;
    personalForetagsIdInput.required = arAgare;

    personalForetagsIdInput.value =
      arAgare && mittForetag
        ? mittForetag.id
        : "";

    const harTillgang =
      arAgare || !!mittForetag;

    noAccessPanel.hidden = harTillgang;

    satEditorText();
  }

  async function visaAdminvy() {
    vyInloggning.hidden = true;
    vyAdmin.hidden = false;

    rubrikTagg.textContent = "Adminpanel";
    statusPrick.classList.add("online");

    const { data: userData } =
      await supabase.auth.getUser();

    const user = userData.user;

    if (user) {
      await ladInBehorighet(user.id);
      visaAdminHubben(
        hamtaVisningsnamn(user)
      );
    }
  }

  function visaInloggningsvy() {
    vyInloggning.hidden = false;
    vyAdmin.hidden = true;

    rubrikTagg.textContent = "Inloggning";
    statusPrick.classList.remove("online");

    satAuthLage("login");
  }

  function visaInloggadAnimation(
    titel: string,
    subtitel: string,
    nasta: () => void
  ) {
    successText.textContent = titel;
    successSub.textContent = subtitel;

    successBadge.classList.add("show");
    successBadge.setAttribute(
      "aria-hidden",
      "false"
    );

    setTimeout(() => {
      successBadge.classList.remove("show");

      successBadge.setAttribute(
        "aria-hidden",
        "true"
      );

      inloggningsformular.reset();
      nasta();
    }, 1200);
  }

  async function kontrolleraSession() {
    const { data } =
      await supabase.auth.getSession();

    if (data.session) {
      await visaAdminvy();
    } else {
      visaInloggningsvy();
    }
  }

  tabLogin.addEventListener(
    "click",
    () => satAuthLage("login")
  );

  tabSignup.addEventListener(
    "click",
    () => satAuthLage("signup")
  );

  inloggningsformular.addEventListener(
    "submit",
    async (handelse) => {
      handelse.preventDefault();

      loginKnapp.disabled = true;

      loginKnapp.textContent =
        authLage === "login"
          ? "Loggar in..."
          : "Skapar konto...";

      loginStatus.style.color =
        "#ff8a7a";

      loginStatus.textContent = "";

      const emailInput =
        document.getElementById(
          "epost"
        ) as HTMLInputElement;

      const passwordInput =
        document.getElementById(
          "losenord"
        ) as HTMLInputElement;

      try {
        if (authLage === "signup") {
          const { data, error } =
            await supabase.auth.signUp({
              email: emailInput.value,
              password: passwordInput.value,
              options: {
                data: {
                  full_name: namnInput.value,
                },
              },
            });

          if (error) {
            loginStatus.textContent =
              "Kunde inte skapa kontot: " +
              error.message;

            return;
          }

          if (!data.session) {
            loginStatus.style.color =
              "var(--blue-soft)";

            loginStatus.textContent =
              `Välkommen, ${namnInput.value}! Kontot är skapat — kolla din e-post och bekräfta adressen innan du loggar in.`;

            inloggningsformular.reset();
            satAuthLage("login");

            return;
          }

          const visningsnamn =
            hamtaVisningsnamn(data.user) ||
            namnInput.value;

          visaInloggadAnimation(
            "Välkommen!",
            `Kontot är skapat för ${visningsnamn}.`,
            visaAdminvy
          );
        } else {
          const { data, error } =
            await supabase.auth.signInWithPassword({
              email: emailInput.value,
              password: passwordInput.value,
            });

          if (error) {
            loginStatus.textContent =
              "Inloggningen misslyckades: " +
              error.message;

            return;
          }

          const visningsnamn =
            hamtaVisningsnamn(data.user);

          visaInloggadAnimation(
            "Välkommen!",
            visningsnamn
              ? `Inloggad som ${visningsnamn}`
              : "Inloggningen lyckades",
            visaAdminvy
          );
        }
      } catch {
        loginStatus.textContent =
          "Kunde inte nå servern. Kontrollera din internetanslutning.";
      } finally {
        loginKnapp.disabled = false;

        loginKnapp.textContent =
          authLage === "login"
            ? "Logga in"
            : "Skapa konto";
      }
    }
  );

  loggaUtBtn.addEventListener(
    "click",
    async () => {
      await supabase.auth.signOut();

      arAgare = false;
      mittForetag = null;

      visaInloggningsvy();
    }
  );

  cardForetag.addEventListener(
    "click",
    () => {
      if (!arAgare) return;

      adminHub.hidden = true;
      adminForms.hidden = false;

      foretagFormular.hidden = false;
      personalFormular.hidden = true;
    }
  );

  cardPersonal.addEventListener(
    "click",
    () => {
      if (!arAgare && !mittForetag) return;

      adminHub.hidden = true;
      adminForms.hidden = false;

      personalFormular.hidden = false;
      foretagFormular.hidden = true;
    }
  );

  cardEditor.addEventListener(
    "click",
    () => {
      window.location.href = "/editor";
    }
  );

  tillbakaBtn.addEventListener(
    "click",
    () => {
      adminForms.hidden = true;
      adminHub.hidden = false;
    }
  );

  foretagFormular.addEventListener(
    "submit",
    async (handelse) => {
      handelse.preventDefault();

      if (!arAgare) return;

      foretagKnapp.disabled = true;
      foretagKnapp.textContent = "Lägger till...";
      foretagStatus.textContent = "";

      const namnInputForetag =
        document.getElementById(
          "foretag-namn"
        ) as HTMLInputElement;

      const domainInput =
        document.getElementById(
          "foretag-domain"
        ) as HTMLInputElement;

      const adressInput =
        document.getElementById(
          "foretag-adress"
        ) as HTMLInputElement;

      const epostInput =
        document.getElementById(
          "foretag-epost"
        ) as HTMLInputElement;

      const agareInput =
        document.getElementById(
          "foretag-agare"
        ) as HTMLInputElement;

      const planInput =
        document.getElementById(
          "foretag-plan"
        ) as HTMLSelectElement;

      try {
        const { error } =
          await supabase
            .from("companies")
            .insert({
              name: namnInputForetag.value,
              domain: domainInput.value,
              address: adressInput.value,
              contact_email: epostInput.value,
              owner: agareInput.value,
              subscription: planInput.value,
            });

        if (error) {
          foretagStatus.style.color =
            "#ff8a7a";

          foretagStatus.textContent =
            "Något gick fel: " +
            error.message;

          return;
        }

        foretagStatus.style.color =
          "var(--green)";

        foretagStatus.textContent =
          "Företaget har lagts till.";

        foretagFormular.reset();
      } catch {
        foretagStatus.style.color =
          "#ff8a7a";

        foretagStatus.textContent =
          "Kunde inte nå servern. Kontrollera din internetanslutning.";
      } finally {
        foretagKnapp.disabled = false;
        foretagKnapp.textContent = "Lägg till";
      }
    }
  );

  personalFormular.addEventListener(
    "submit",
    async (handelse) => {
      handelse.preventDefault();

      const foretagsId =
        arAgare
          ? personalForetagsIdInput.value
          : mittForetag?.id;

      if (!foretagsId) {
        personalStatus.style.color =
          "#ff8a7a";

        personalStatus.textContent =
          arAgare
            ? "Ange vilket företags-ID personalen ska läggas till på."
            : "Vi hittar inget företag kopplat till ditt konto.";

        return;
      }

      personalKnapp.disabled = true;
      personalKnapp.textContent = "Lägger till...";
      personalStatus.textContent = "";

      const namnInputPersonal =
        document.getElementById(
          "personal-namn"
        ) as HTMLInputElement;

      const rollInput =
        document.getElementById(
          "personal-roll"
        ) as HTMLInputElement;

      const epostInput =
        document.getElementById(
          "personal-epost"
        ) as HTMLInputElement;

      const telefonInput =
        document.getElementById(
          "personal-telefon"
        ) as HTMLInputElement;

      try {
        const { error } =
          await supabase.rpc(
            "add_staff_member",
            {
              company_id_input: foretagsId,
              email_input: epostInput.value,
              name_input: namnInputPersonal.value,
              role_input: rollInput.value,
              phone_input: telefonInput.value,
            }
          );

        if (error) {
          personalStatus.style.color =
            "#ff8a7a";

          personalStatus.textContent =
            "Något gick fel: " +
            error.message;

          return;
        }

        personalStatus.style.color =
          "var(--green)";

        personalStatus.textContent =
          "Personalen har lagts till.";

        personalFormular.reset();
      } catch {
        personalStatus.style.color =
          "#ff8a7a";

        personalStatus.textContent =
          "Kunde inte nå servern. Kontrollera din internetanslutning.";
      } finally {
        personalKnapp.disabled = false;
        personalKnapp.textContent = "Lägg till";
      }
    }
  );

  kontrolleraSession();
</script>
