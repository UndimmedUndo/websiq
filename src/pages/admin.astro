<header class="site-header">
  <div class="wrap header-row">
    <a href="/" class="logo" aria-label="websiqAI hem">
      <span class="logo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="logo-text">web<span class="accent">siq</span> AI</span>
    </a>

    <span class="header-tag-wrap">
      <span class="header-status-dot" id="header-status-dot" aria-hidden="true"></span>
      <span class="header-tag" id="header-tag">Inloggning</span>
    </span>
  </div>
</header>

<main id="vy-inloggning" class="view">
  <section class="login-section">
    <div class="wrap login-grid">
      <div class="login-copy reveal in-view">
        <p class="eyebrow">Adminpanel</p>
        <h1 id="login-titel">Välkommen tillbaka</h1>
        <p class="login-sub" id="login-undertext">
          Logga in med ditt konto för att hantera företag och personal.
        </p>
      </div>

      <div class="login-card reveal in-view" id="login-card">
        <div class="auth-tabs" role="tablist" id="auth-tabs">
          <button
            type="button"
            class="auth-tab active"
            id="tab-login"
            role="tab"
            aria-selected="true"
          >
            Logga in
          </button>

          <button
            type="button"
            class="auth-tab"
            id="tab-signup"
            role="tab"
            aria-selected="false"
          >
            Skapa konto
          </button>
        </div>

        <form id="inloggningsformular">
          <div class="field namn-falt" id="namn-falt">
            <label for="namn">Namn</label>
            <input
              id="namn"
              name="namn"
              type="text"
              autocomplete="name"
              placeholder="För- och efternamn"
            />
          </div>

          <div class="field">
            <label for="epost">E-post</label>
            <input
              id="epost"
              name="epost"
              type="email"
              autocomplete="email"
              placeholder="namn@företag.se"
              required
            />
          </div>

          <div class="field">
            <label for="losenord">Lösenord</label>
            <input
              id="losenord"
              name="losenord"
              type="password"
              autocomplete="current-password"
              placeholder="••••••••"
              required
            />
            <span class="field-hint" id="losenord-hint">Minst 6 tecken</span>
          </div>

          <p class="login-status" id="login-status"></p>

          <button
            class="btn btn-primary login-btn"
            type="submit"
            id="login-knapp"
          >
            Logga in
          </button>
        </form>

        <div
          class="success-overlay"
          id="success-badge"
          aria-hidden="true"
        >
          <svg
            class="success-check"
            viewBox="0 0 52 52"
            aria-hidden="true"
          >
            <circle
              class="success-check-circle"
              cx="26"
              cy="26"
              r="24"
              fill="none"
            />
            <path
              class="success-check-mark"
              fill="none"
              d="M14 27l7 7 16-16"
            />
          </svg>

          <span class="success-title" id="success-text">
            Välkommen!
          </span>

          <span class="success-sub" id="success-sub"></span>
        </div>
      </div>
    </div>
  </section>
</main>

<main id="vy-admin" class="view" hidden>
  <section class="section admin-section">
    <div class="wrap">
      <div id="admin-hub">
