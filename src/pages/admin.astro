          hidden
        >
          <h3>Lägg till företag</h3>

          <div class="field">
            <label for="foretag-namn">Namn</label>
            <input
              id="foretag-namn"
              name="namn"
              type="text"
              required
            />
          </div>

          <div class="field">
            <label for="foretag-domain">Domän</label>
            <input
              id="foretag-domain"
              name="domain"
              type="text"
              placeholder="dittforetag.se"
              required
            />
          </div>

          <div class="field">
            <label for="foretag-adress">Adress</label>
            <input
              id="foretag-adress"
              name="adress"
              type="text"
              required
            />
          </div>

          <div class="field">
            <label for="foretag-epost">Kontakt-e-post</label>
            <input
              id="foretag-epost"
              name="kontaktEpost"
              type="email"
              required
            />
          </div>

          <div class="field">
            <label for="foretag-agare">
              Ägarens användar-ID (UUID)
            </label>

            <input
              id="foretag-agare"
              name="agareUuid"
              type="text"
              placeholder="t.ex. af874aa5-883b-477a-b505-a1b471fd4091"
              required
            />

            <span class="field-hint">
              Personen måste redan ha skapat ett konto i adminpanelen.
            </span>
          </div>

          <div class="field">
            <label for="foretag-plan">Plan</label>

            <select
              id="foretag-plan"
              name="plan"
              required
            >
              <option value="None">None</option>
              <option value="Start">Start</option>
              <option value="Business">Business</option>
              <option value="Premium">Premium</option>
              <option value="Enterprise">Enterprise</option>
            </select>
          </div>

          <p
