<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WebsiqAI</title>
    <meta
      name="description"
      content="WebsiqAI ger företag en professionell webbsida, bokningssystem, inloggningar och hosting i ett paket. Redigera själva, helt utan kod."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <div class="wrap header-row">
        <a href="#top" class="logo" aria-label="WebsiqAI hem">
          <span class="logo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="logo-text">Web<span class="accent">siq</span> AI</span>
        </a>
        <nav class="site-nav" aria-label="Primär">
          {navigering.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a href="/admin" class="admin-link" aria-label="Till adminpanelen">
          <span class="admin-link-dot" aria-hidden="true"></span>
          Admin
        </a>
        <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Öppna meny">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobil">
        {navigering.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/admin">Admin</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow">Webbsida, bokning & hosting i ett paket</p>
            <h1>Er nya webbsida, redo att ta emot kunder</h1>
            <p class="hero-sub">
              WebsiqAI ger er en professionell webbsida, bokningssystem, inloggningar
              och molnhosting i ett och samma paket. Ni väljer paket, vi sätter igång
              direkt, och sedan styr ni allt själva i en enkel meny, helt utan kod.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#kontakt">Skaffa min webbsida</a>
              <a class="btn btn-ghost" href="#process">Se hur det fungerar</a>
            </div>
            <p class="demo-note">
              Demonstrationer:
              <a href={demolankar[0].url} target="_blank" rel="noopener noreferrer">{demolankar[0].namn}</a> ·
              <a href={demolankar[1].url} target="_blank" rel="noopener noreferrer">{demolankar[1].namn}</a> ·
              <a href={demolankar[2].url} target="_blank" rel="noopener noreferrer">{demolankar[2].namn}</a>
            </p>
          </div>

          <div class="hero-visual reveal" style="--delay: 120ms">
            <div class="browser" role="img" aria-label="Förhandsvisning av en webbsida som genereras i ett webbläsarfönster">
              <div class="browser-chrome">
                <span class="dot dot-a"></span><span class="dot dot-b"></span><span class="dot dot-c"></span>
                <div class="address-bar">
                  <span class="lock" aria-hidden="true">🔒</span>
                  <span id="typer" class="typer"></span><span class="caret" aria-hidden="true"></span>
                </div>
              </div>
              <div class="browser-body">
                <div class="skel skel-nav">
                  <span class="skel-dot"></span>
                  <span class="skel-line short"></span>
                  <span class="skel-line short"></span>
                  <span class="skel-pill"></span>
                </div>
                <div class="skel skel-hero">
                  <span class="skel-line wide big"></span>
                  <span class="skel-line mid big"></span>
                  <span class="skel-line short"></span>
                  <span class="skel-cta"></span>
                </div>
                <div class="skel skel-cards">
                  <span class="skel-card"></span><span class="skel-card"></span><span class="skel-card"></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="capabilities reveal" aria-label="Kompetenser">
          <div class="capabilities-track">
            {kompetenser.map((c) => <span class="tab">{c}</span>)}
          </div>
        </div>
      </section>

      <section id="tjanster" class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Vad ni får</p>
            <h2>En komplett digital lösning för er verksamhet</h2>
          </div>
          <div class="cards-grid">
            {tjanster.map((s, i) => (
              <div class="card reveal" style={`--delay: ${i * 80}ms`}>
                <span class="card-tag">{s.tagg}</span>
                <h3>{s.titel}</h3>
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="process" class="section section-alt">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Så går det till</p>
            <h2>Från beställning till lanserad sida, utan krångel.</h2>
          </div>
          <div class="terminal reveal">
            <div class="terminal-bar">
              <span class="dot dot-a"></span><span class="dot dot-b"></span><span class="dot dot-c"></span>
              <span class="terminal-title">projekt.log</span>
            </div>
            <ol class="terminal-body">
              {steg.map((s) => (
                <li class="term-line">
                  <span class="line-no">{s.nr}</span>
                  <span class="term-cmd">$ {s.kommando}</span>
                  <span class="term-body">{s.text}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section id="arbete" class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Vilka vi passar för</p>
            <h2>Byggt för företag som lever i verkligheten men även vill synas digitalt.</h2>
          </div>
          <div class="niche-grid">
            {nischer.map((n, i) => (
              <div class={`niche reveal niche-${n.accent}`} style={`--delay: ${i * 70}ms`}>
                <div class="niche-thumb" aria-hidden="true">
                  <span class="dot dot-a"></span><span class="dot dot-b"></span><span class="dot dot-c"></span>
                  <span class="niche-bar"></span>
                  <span class="niche-block"></span>
                </div>
                <h3>{n.titel}</h3>
                <p>{n.notering}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-alt">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Varför WebsiqAI</p>
            <h2>WebsiqAI hanterar allt digitalt, inte bara en webbsida. Hosting, bokningar och mer, så ni kan fokusera på er verksamhet.</h2>
          </div>
          <div class="values-grid">
            {vardegrund.map((v, i) => (
              <div class="value reveal" style={`--delay: ${i * 80}ms`}>
                <h3>{v.titel}</h3>
                <p>{v.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="priser" class="section">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Priser</p>
            <h2>En investering som betalar sig snabbt</h2>
            <p class="section-legal-note">En proffsig, AI-genererad webbsida är ofta det som avgör om en kund väljer er eller konkurrenten. Priset är enkelt och förutsägbart, utan dolda avgifter och utan bindningstid, och täcker hosting, domän, HTTPS/SSL, molninfrastruktur, inlogg, bokning och löpande support. Ändrar ni er om något behöver justeras är det bara att höra av sig, så fixar vi det.</p>
          </div>
          <div class="plans-grid">
            {paket.map((p, i) => (
              <div class={`plan reveal ${p.framhavd ? "plan-highlight" : ""} ${p.badge && !p.framhavd ? "plan-enterprise" : ""}`} style={`--delay: ${i * 80}ms`}>
                {p.badge && <span class="plan-badge">{p.badge}</span>}
                <p class="plan-name">{p.namn}</p>
                <p class="plan-price"><span class="plan-amount">{p.pris}</span> kr/månad</p>
                <p class="plan-perday">motsvarar ca {Math.round(Number(p.pris) / 30)} kr/dag</p>
                <p class="plan-note">Ingen bindningstid, avsluta när som helst</p>
                <ul class="plan-features">
                  {p.funktioner.map((f) => <li>{f}</li>)}
                </ul>
                <p class="plan-legal">{p.agande}</p>
                <a class={`btn ${p.framhavd ? "btn-primary" : "btn-ghost"} plan-btn`} href="#kontakt" data-paket={p.namn}>Köp {p.namn} och sätt igång</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="vanliga-fragor" class="section section-alt">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Vanliga frågor</p>
            <h2>Bra att veta innan ni hör av er.</h2>
          </div>
          <div class="faq-list">
            {vanligaFragor.map((f, i) => (
              <details class="faq-item reveal" style={`--delay: ${i * 60}ms`}>
                <summary>{f.fraga}</summary>
                <p>{f.svar}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="section contact">
        <div class="wrap contact-grid">
          <div class="reveal">
            <p class="eyebrow">Beställ eller fråga oss</p>
            <h2>Välj paket, så sätter vi igång direkt</h2>
            <p class="hero-sub">Fyll i formuläret för att beställa ert paket och komma igång direkt, eller skriv era frågor så återkommer vi så snart vi kan.</p>
          </div>
          <form class="contact-form reveal" style="--delay: 100ms" action="mailto:hello@websiq.example" method="POST" enctype="text/plain">
            <div class="field">
              <label for="name">Namn</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="business">Företagsnamn</label>
              <input id="business" name="business" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="email">E-post</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="paket">Vilket paket vill ni ha?</label>
              <select id="paket" name="paket">
                <option value="">Jag har frågor först</option>
                <option value="Start">Start – 79 kr/månad</option>
                <option value="Business">Business – 149 kr/månad</option>
                <option value="Premium">Premium – 229 kr/månad</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Berätta om företaget, eller skriv er fråga</label>
              <textarea id="message" name="message" rows="4"></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Skicka beställning</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <a href="#top" class="logo"><span class="logo-text">Web<span class="accent">siq</span> AI</span></a>
        <nav class="footer-nav" aria-label="Sidfot">
          {navigering.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="footer-email" href="mailto:hello@websiq.example">hello@websiq.example</a>
      </div>
      <div class="wrap">
        <p class="footer-fine">© {new Date().getFullYear()} WebsiqAI. Innehåll och design på den här sidan tillhör WebsiqAI. Vad som gäller kring ägande och tillgång för respektive paket hittar ni under Priser.</p>
      </div>
    </footer>

    <script>
      const menyknapp = document.getElementById("menu-toggle");
      const mobilNav = document.getElementById("mobile-nav");
      menyknapp?.addEventListener("click", () => {
        const oppen = mobilNav?.classList.toggle("open");
        menyknapp.setAttribute("aria-expanded", String(!!oppen));
      });
      mobilNav?.querySelectorAll("a").forEach((lank) =>
        lank.addEventListener("click", () => {
          mobilNav.classList.remove("open");
          menyknapp?.setAttribute("aria-expanded", "false");
        })
      );

      document.querySelectorAll("[data-paket]").forEach((knapp) => {
        knapp.addEventListener("click", () => {
          const valdPaket = document.getElementById("paket");
          if (valdPaket) valdPaket.value = knapp.dataset.paket;
        });
      });

      const reducerRorelse = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const skrivare = document.getElementById("typer");
      const fraser = ["hembutik.se", "pizzaresturang.se", "frisoren.se", "dittforetag.se"];
      if (skrivare) {
        if (reducerRorelse) {
          skrivare.textContent = "dittforetag.se";
        } else {
          let frasIndex = 0, teckenIndex = 0, raderar = false;
          const tick = () => {
            const nuvarande = fraser[frasIndex];
            if (!raderar) {
              teckenIndex++;
              skrivare.textContent = nuvarande.slice(0, teckenIndex);
              if (teckenIndex === nuvarande.length) { raderar = true; setTimeout(tick, 1400); return; }
            } else {
              teckenIndex--;
              skrivare.textContent = nuvarande.slice(0, teckenIndex);
              if (teckenIndex === 0) { raderar = false; frasIndex = (frasIndex + 1) % fraser.length; }
            }
            setTimeout(tick, raderar ? 35 : 70);
          };
          tick();
        }
      }

      const synligaElement = document.querySelectorAll(".reveal");
      if (reducerRorelse) {
        synligaElement.forEach((el) => el.classList.add("in-view"));
      } else {
        const observerare = new IntersectionObserver(
          (poster) => poster.forEach((post) => {
            if (post.isIntersecting) { post.target.classList.add("in-view"); observerare.unobserve(post.target); }
          }),
          { threshold: 0.15 }
        );
        synligaElement.forEach((el) => observerare.observe(el));
      }
    </script>

